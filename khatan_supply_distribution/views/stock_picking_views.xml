<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock Picking Form View Inherit: Total Demand Footer Sum on Operations Moves -->
    <record id="view_picking_form_inherit_total_demand" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.total.demand</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="sum">Total Demand = </attribute>
            </xpath>
        </field>
    </record>
</odoo>

