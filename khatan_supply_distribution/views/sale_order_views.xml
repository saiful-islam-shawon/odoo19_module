<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Sales Order Form View Inherit: Total Qty Footer Sum on Order Lines -->
    <record id="view_order_form_inherit_total_qty" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.total.qty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list//field[@name='product_uom_qty']" position="attributes">
                <attribute name="sum">Quantity</attribute>
                <attribute name="width">120px</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='qty_delivered']" position="attributes">
                <attribute name="sum">Delivered</attribute>
                <attribute name="width">120px</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']/list//field[@name='qty_invoiced']" position="attributes">
                <attribute name="sum">Invoiced</attribute>
                <attribute name="width">120px</attribute>
            </xpath>
        </field>
    </record>

    <!-- Base Sale Order Tree Inherit: Total Qty Column & Footer Sum (Automatically inherited by Quotations & Orders) -->
    <record id="sale_order_tree_inherit_total_qty" model="ir.ui.view">
        <field name="name">sale.order.tree.inherit.total.qty</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="total_qty" optional="show" sum="Total Qty"/>
            </xpath>
        </field>
    </record>
</odoo>
