<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchase Order & RFQ Form View Inherit: Total Qty Footer & Purchase Agent Field -->
    <record id="purchase_order_form_inherit_total_qty" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.total.qty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <!-- Add dynamic footer sum on order lines table -->
            <xpath expr="//field[@name='order_line']/list//field[@name='product_qty']" position="attributes">
                <attribute name="sum">Total Qty = </attribute>
            </xpath>
            <!-- Add Purchase Agent field after Fiscal Position in Other Information tab -->
            <xpath expr="//field[@name='fiscal_position_id']" position="after">
                <field name="purchase_agent_id"/>
            </xpath>
        </field>
    </record>

    <!-- RFQ List View (KPIs Tree) Inherit: Total Qty Column & Footer Sum -->
    <record id="purchase_order_kpis_tree_inherit_total_qty" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit.total.qty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="total_qty" optional="show" sum="Total Qty"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order View List Inherit: Total Qty Column & Footer Sum -->
    <record id="purchase_order_view_tree_inherit_total_qty" model="ir.ui.view">
        <field name="name">purchase.order.view.tree.inherit.total.qty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="total_qty" optional="show" sum="Total Qty"/>
            </xpath>
        </field>
    </record>

    <!-- Purchase Order Tree (Standard) Inherit: Total Qty Column & Footer Sum -->
    <record id="purchase_order_tree_inherit_total_qty" model="ir.ui.view">
        <field name="name">purchase.order.tree.inherit.total.qty</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='amount_total']" position="before">
                <field name="total_qty" optional="show" sum="Total Qty"/>
            </xpath>
        </field>
    </record>
</odoo>

