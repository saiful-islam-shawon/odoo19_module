<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="zsl_login_branding" name="Zencore VAT Login Branding" inherit_id="web.login" priority="60">
        <xpath expr="//form[@role='form' and @method='post']" position="before">
            <style type="text/css">
                body:has(.zsl-vat-login-info) {background:radial-gradient(circle at 50% 0%, #263238 0, #151719 58%) !important; min-height:100vh;}
                body:has(.zsl-vat-login-info) .container {min-height:100vh; display:flex; align-items:center; justify-content:center; padding:24px !important;}
                body:has(.zsl-vat-login-info) .card {width:820px !important; max-width:100% !important; border:0 !important; border-radius:18px !important; box-shadow:0 28px 70px rgba(0,0,0,.5) !important; overflow:hidden; background:#2d3034 !important;}
                body:has(.zsl-vat-login-info) .card-body {display:grid; grid-template-columns:46% 54%; padding:0 !important; min-height:410px; background:#2d3034 !important; align-items:stretch;}
                body:has(.zsl-vat-login-info) .card-body > .text-center.pb-3 {display:none !important;}
                body:has(.zsl-vat-login-info) .card-body > .oe_login_form {grid-column:2; grid-row:1; width:100%; max-width:none; min-height:410px; padding:42px 42px 36px; margin:0; color:#fff; align-self:stretch; display:flex !important; flex-direction:column; justify-content:center;}
                body:has(.zsl-vat-login-info) .card-body > .oe_structure {display:none;}
                body:has(.zsl-vat-login-info) .card-body > .text-center.small {display:none;}
                body:has(.zsl-vat-login-info) owl-component[name="web.user_switch"],
                body:has(.zsl-vat-login-info) .oe_login_form .o_login_auth,
                body:has(.zsl-vat-login-info) .oe_login_form a[href*="/web/signup"],
                body:has(.zsl-vat-login-info) .oe_login_form a[href*="/web/database"],
                body:has(.zsl-vat-login-info) .oe_login_form .btn-link {display:none !important;}
                @media (min-width: 768px) {
                  body:has(.zsl-vat-login-info) .card-body > .zsl-vat-login-info {grid-column:1; grid-row:1;}
                }
                .zsl-vat-login-info {background:linear-gradient(155deg, #1299b0 0%, #087d98 100%); color:#fff; padding:43px 38px; margin:0; text-align:left; min-height:410px; height:100%;}
                .zsl-vat-login-info .zsl-logo-mark {font-size:23px; font-weight:800; letter-spacing:.35px; line-height:1.1;}
                .zsl-vat-login-info .zsl-company-name {font-size:16px; font-weight:600; margin:16px 0 27px; opacity:.98;}
                .zsl-vat-login-info .zsl-divider {border:0; border-top:1px solid rgba(255,255,255,.3); margin:0 0 24px;}
                .zsl-vat-login-info h2 {font-size:18px; font-weight:700; color:#fff; margin:0 0 11px;}
                .zsl-vat-login-info p {font-size:12px; margin:0 0 25px; color:#eafaff;}
                .zsl-vat-login-info .zsl-feature {font-size:13px; margin:0 0 17px; display:flex; align-items:center; gap:11px;}
                .zsl-vat-login-info .zsl-feature i {width:12px; text-align:center;}
                body:has(.zsl-vat-login-info) .oe_login_form .zsl-login-heading {text-align:center; margin:0 0 25px;}
                body:has(.zsl-vat-login-info) .oe_login_form .zsl-login-heading i {font-size:22px; color:#93ddea; display:block; margin-bottom:9px;}
                body:has(.zsl-vat-login-info) .oe_login_form .zsl-login-heading h1 {font-size:22px; color:#fff; margin:0; font-weight:700;}
                body:has(.zsl-vat-login-info) .oe_login_form .zsl-login-heading p {font-size:12px; color:#bdc8cc; margin:5px 0 0;}
                body:has(.zsl-vat-login-info) .oe_login_form .form-label {color:#dce8eb; font-size:13px; margin-bottom:7px; font-weight:500;}
                body:has(.zsl-vat-login-info) .oe_login_form .form-control {background:#23262a; color:#fff; border:1px solid #4c565b; border-radius:8px; min-height:42px; font-size:13px; padding:.55rem .75rem;}
                body:has(.zsl-vat-login-info) .oe_login_form .form-control:focus {border-color:#24b4ca; box-shadow:0 0 0 .18rem rgba(36,180,202,.16);}
                body:has(.zsl-vat-login-info) .oe_login_form .form-control::placeholder {color:#89969a;}
                body:has(.zsl-vat-login-info) .oe_login_form .input-group .btn {background:#23262a; color:#cbd8db; border-color:#4c565b;}
                body:has(.zsl-vat-login-info) .oe_login_form .btn-primary {background:#1198b0; border-color:#1198b0; border-radius:8px; min-height:42px; font-size:14px; font-weight:700; transition:background .15s ease;}
                body:has(.zsl-vat-login-info) .oe_login_form .btn-primary:hover {background:#0b8298; border-color:#0b8298;}
                body:has(.zsl-vat-login-info) .oe_login_form .mb-3 {margin-bottom:16px !important;}
                body:has(.zsl-vat-login-info) .oe_login_form .oe_login_buttons {padding-top:1px !important;}
                @media (max-width: 767px) {
                  body:has(.zsl-vat-login-info) .card-body {display:block;}
                  .zsl-vat-login-info {min-height:0; padding:32px 30px;}
                  body:has(.zsl-vat-login-info) .card-body > .oe_login_form {min-height:0; padding:36px 30px;}
                }
            </style>
            <section class="zsl-vat-login-info" aria-label="Zencore VAT platform">
                <div class="zsl-logo-mark">ZENCORE</div>
                <div class="zsl-company-name">Solutions Limited</div>
                <hr class="zsl-divider"/>
                <h2>VAT Management System</h2>
                <p>Bangladesh VAT &amp; Mushak Compliance</p>
                <div class="zsl-feature"><i class="fa fa-file-text-o"/> Mushak Reports</div>
                <div class="zsl-feature"><i class="fa fa-calculator"/> VAT Calculation</div>
                <div class="zsl-feature"><i class="fa fa-shield"/> Secure Access</div>
            </section>
        </xpath>
        <xpath expr="//form[@role='form' and @method='post']/input[@name='csrf_token']" position="before">
            <div class="zsl-login-heading">
                <i class="fa fa-lock"/>
                <h1>Welcome Back</h1>
                <p>Sign in to VAT Management</p>
            </div>
        </xpath>
        <xpath expr="//owl-component[@name='web.user_switch']" position="replace">
            <t t-if="False"/>
        </xpath>
        <xpath expr="//form[@role='form' and @method='post']" position="attributes">
            <attribute name="t-attf-class">oe_login_form</attribute>
        </xpath>
        <xpath expr="//label[@for='login']" position="replace">
            <label for="login" class="form-label d-flex justify-content-between">Username</label>
        </xpath>
        <xpath expr="//input[@id='login']" position="attributes">
            <attribute name="placeholder">Enter your username</attribute>
        </xpath>
        <xpath expr="//input[@id='password']" position="attributes">
            <attribute name="placeholder">Enter your password</attribute>
        </xpath>
        <xpath expr="//button[@type='submit' and not(@name)]" position="replace">
            <button type="submit" class="btn btn-primary">Sign In</button>
        </xpath>
    </template>
</odoo>
