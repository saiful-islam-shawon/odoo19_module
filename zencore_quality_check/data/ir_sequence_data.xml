<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_zencore_seed_receipt" model="ir.sequence">
            <field name="name">Seed Receipt Sequence</field>
            <field name="code">zencore.seed.receipt.seq</field>
            <field name="prefix">QC/REC/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_zencore_seed_lab_test" model="ir.sequence">
            <field name="name">Seed Lab Test Sequence</field>
            <field name="code">zencore.seed.lab.test.seq</field>
            <field name="prefix">QC/LAB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Seed Processing Batch Sequence -->
        <record id="seq_zencore_seed_processing_batch" model="ir.sequence">
            <field name="name">Seed Processing Batch Sequence</field>
            <field name="code">zencore.seed.processing.batch.seq</field>
            <field name="prefix">PB/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Seed Processing Lot Sequence (Format 1) -->
        <record id="seq_zencore_seed_processing_lot" model="ir.sequence">
            <field name="name">Seed Processing Lot Sequence (Format 1)</field>
            <field name="code">zencore.seed.processing.lot.seq</field>
            <field name="prefix">LOT/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Processed Seed QC Sequence -->
        <record id="seq_zencore_processed_seed_qc" model="ir.sequence">
            <field name="name">Processed Seed QC Sequence</field>
            <field name="code">zencore.processed.seed.qc.seq</field>
            <field name="prefix">QC/PS/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
