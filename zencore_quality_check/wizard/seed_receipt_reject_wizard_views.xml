<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seed_receipt_reject_wizard_form" model="ir.ui.view">
        <field name="name">zencore.seed.receipt.reject.wizard.form</field>
        <field name="model">zencore.seed.receipt.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Consignment">
                <group>
                    <field name="receipt_id" invisible="1"/>
                    <field name="rejection_reason" placeholder="Explain in detail why this seed consignment is being rejected (e.g. excessive torn bags, visible pests, high moisture)..."/>
                </group>
                <footer>
                    <button name="action_confirm_reject" string="Confirm Reject" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
