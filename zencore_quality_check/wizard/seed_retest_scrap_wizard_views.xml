<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seed_retest_scrap_wizard_form" model="ir.ui.view">
        <field name="name">zencore.seed.retest.scrap.wizard.form</field>
        <field name="model">zencore.seed.retest.scrap.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Seed Scrapping">
                <group>
                    <field name="retest_id" invisible="1"/>
                    <field name="scrap_reason" placeholder="Explain why this seed lot failed retesting (e.g., loss of germination, mold, pest infestation, high moisture)..."/>
                </group>
                <footer>
                    <button name="action_confirm_scrap" string="Confirm &amp; Scrap" type="object" class="btn-danger"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

