<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_zencore_seed_retest_list" model="ir.ui.view">
        <field name="name">zencore.seed.retest.list</field>
        <field name="model">zencore.seed.retest</field>
        <field name="arch" type="xml">
            <list string="Seed Retest Evaluations" sample="1">
                <field name="name"/>
                <field name="date_retest"/>
                <field name="storage_id"/>
                <field name="product_id"/>
                <field name="lot_name"/>
                <field name="category"/>
                <field name="bag_count"/>
                <field name="quantity" string="Weight (kg)"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'passed'"
                       decoration-danger="state == 'failed'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_zencore_seed_retest_form" model="ir.ui.view">
        <field name="name">zencore.seed.retest.form</field>
        <field name="model">zencore.seed.retest</field>
        <field name="arch" type="xml">
            <form string="Seed Retest Evaluation">
                <header>
                    <button name="action_release"
                            string="Approve &amp; Release"
                            type="object"
                            class="btn-success"
                            invisible="state != 'draft'"/>
                    <button name="action_scrap"
                            string="Fail &amp; Scrap"
                            type="object"
                            class="btn-danger"
                            invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,passed,failed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Passed &amp; Released" bg_color="text-bg-success" invisible="state != 'passed'"/>
                    <widget name="web_ribbon" title="Failed &amp; Scrapped" bg_color="text-bg-danger" invisible="state != 'failed'"/>

                    <div class="alert alert-danger" role="alert" invisible="state != 'failed'">
                        <strong>Scrap Reason:</strong> <field name="scrap_reason" readonly="1"/>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="Retest Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <group>
                        <group string="Storage Lot &amp; Origin">
                            <field name="storage_id"/>
                            <field name="product_id"/>
                            <field name="lot_name"/>
                            <field name="lot_id" optional="show"/>
                            <field name="category"/>
                            <field name="pack_size"/>
                            <field name="bag_count"/>
                            <field name="quantity"/>
                        </group>
                        <group string="Dates &amp; Evaluation Audit">
                            <field name="storage_date"/>
                            <field name="validity_date"/>
                            <field name="date_retest" readonly="state != 'draft'"/>
                            <field name="tested_by_id" readonly="state != 'draft'"/>
                            <field name="evaluated_by_id" invisible="not evaluated_by_id"/>
                            <field name="date_evaluated" invisible="not date_evaluated"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Retest Parameters" name="retest_parameters">
                            <field name="line_ids" readonly="state != 'draft'">
                                <list editable="bottom" string="Seed Retest Quality Benchmark">
                                    <field name="sequence" widget="handle"/>
                                    <field name="parameter_name"/>
                                    <field name="unit"/>
                                    <field name="standard_value"/>
                                    <field name="measured_value"/>
                                    <field name="result"/>
                                    <field name="remarks"/>
                                </list>
                            </field>
                        </page>

                        <page string="Retest Notes" name="retest_notes">
                            <field name="notes" placeholder="Enter lab observations, equipment details, or notes..." readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <chatter>
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </chatter>
                </div>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_zencore_seed_retest_search" model="ir.ui.view">
        <field name="name">zencore.seed.retest.search</field>
        <field name="model">zencore.seed.retest</field>
        <field name="arch" type="xml">
            <search string="Search Retests">
                <field name="name" string="Reference"/>
                <field name="product_id" string="Product"/>
                <field name="lot_name" string="Lot Number"/>
                <field name="storage_id" string="Cold Storage Ref"/>

                <filter string="Testing in Progress" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Passed / Released" name="filter_passed" domain="[('state', '=', 'passed')]"/>
                <filter string="Failed / Scrapped" name="filter_failed" domain="[('state', '=', 'failed')]"/>

                <group>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_zencore_seed_retest" model="ir.actions.act_window">
        <field name="name">Retest</field>
        <field name="res_model">zencore.seed.retest</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zencore_seed_retest_search"/>
        <field name="context">{'search_default_filter_draft': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Retest records found!
            </p>
            <p>
                Expired seed lots from Cold Storage will appear here for laboratory quality re-evaluation.
            </p>
        </field>
    </record>
</odoo>

