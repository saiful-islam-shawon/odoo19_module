<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_invoice_narrow" model="report.paperformat">
        <field name="name">Narrow Invoice (150mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">295</field>
        <field name="page_width">150</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">1.63</field>
        <field name="margin_right">7.63</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">90</field>
    </record>

    <record id="account.account_invoices" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_invoice_narrow"/>
        <field name="report_name">systech_report.report_invoice_document_top</field>
    </record>

    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_invoice_narrow"/>
        <field name="report_name">systech_report.report_invoice_document_top</field>
    </record>

</odoo>