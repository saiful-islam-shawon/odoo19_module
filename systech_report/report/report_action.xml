<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_money_receipt" model="report.paperformat">
        <field name="name">Money Receipt (175mm)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">297</field>
        <field name="page_width">150</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">35</field>
        <field name="margin_bottom">5</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">3</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_money_receipt" model="ir.actions.report">
        <field name="name">Money Receipt</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">systech_report.report_money_receipt_template</field>
        <field name="report_file">systech_report.report_money_receipt_template</field>
        <field name="print_report_name">'Money Receipt - ' + (object.name or '')</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_money_receipt"/>
    </record>

    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="paperformat_id" ref="paperformat_money_receipt"/>
    </record>

</odoo>
