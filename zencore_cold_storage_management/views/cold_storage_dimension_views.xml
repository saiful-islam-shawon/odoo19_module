<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ========================================== -->
    <!-- CHAMBER                                    -->
    <!-- ========================================== -->
    <record id="view_cold_storage_chamber_list" model="ir.ui.view">
        <field name="name">cold.storage.chamber.list</field>
        <field name="model">cold.storage.chamber</field>
        <field name="arch" type="xml">
            <list string="Chambers" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_cold_storage_chamber_form" model="ir.ui.view">
        <field name="name">cold.storage.chamber.form</field>
        <field name="model">cold.storage.chamber</field>
        <field name="arch" type="xml">
            <form string="Chamber">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Chamber 1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cold_storage_chamber" model="ir.actions.act_window">
        <field name="name">Chamber</field>
        <field name="res_model">cold.storage.chamber</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define cold storage chambers</p>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- FLOOR                                      -->
    <!-- ========================================== -->
    <record id="view_cold_storage_floor_list" model="ir.ui.view">
        <field name="name">cold.storage.floor.list</field>
        <field name="model">cold.storage.floor</field>
        <field name="arch" type="xml">
            <list string="Floors" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_cold_storage_floor_form" model="ir.ui.view">
        <field name="name">cold.storage.floor.form</field>
        <field name="model">cold.storage.floor</field>
        <field name="arch" type="xml">
            <form string="Floor">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. 1st Floor"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cold_storage_floor" model="ir.actions.act_window">
        <field name="name">Floor</field>
        <field name="res_model">cold.storage.floor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define cold storage floors</p>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- LINE                                       -->
    <!-- ========================================== -->
    <record id="view_cold_storage_line_list" model="ir.ui.view">
        <field name="name">cold.storage.line.list</field>
        <field name="model">cold.storage.line</field>
        <field name="arch" type="xml">
            <list string="Lines" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_cold_storage_line_form" model="ir.ui.view">
        <field name="name">cold.storage.line.form</field>
        <field name="model">cold.storage.line</field>
        <field name="arch" type="xml">
            <form string="Line">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Line A"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cold_storage_line" model="ir.actions.act_window">
        <field name="name">Line</field>
        <field name="res_model">cold.storage.line</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define cold storage lines</p>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- POCKET                                     -->
    <!-- ========================================== -->
    <record id="view_cold_storage_pocket_list" model="ir.ui.view">
        <field name="name">cold.storage.pocket.list</field>
        <field name="model">cold.storage.pocket</field>
        <field name="arch" type="xml">
            <list string="Pockets" editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_cold_storage_pocket_form" model="ir.ui.view">
        <field name="name">cold.storage.pocket.form</field>
        <field name="model">cold.storage.pocket</field>
        <field name="arch" type="xml">
            <form string="Pocket">
                <sheet>
                    <group>
                        <field name="name" placeholder="e.g. Pocket 101"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_cold_storage_pocket" model="ir.actions.act_window">
        <field name="name">Pocket</field>
        <field name="res_model">cold.storage.pocket</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define cold storage pockets</p>
        </field>
    </record>

    <!-- ========================================== -->
    <!-- SUBMENUS UNDER CONFIGURATION               -->
    <!-- ========================================== -->
    <menuitem id="menu_cold_storage_chamber"
              name="Chamber"
              parent="menu_cold_storage_configuration"
              action="action_cold_storage_chamber"
              sequence="20"/>

    <menuitem id="menu_cold_storage_floor"
              name="Floor"
              parent="menu_cold_storage_configuration"
              action="action_cold_storage_floor"
              sequence="30"/>

    <menuitem id="menu_cold_storage_line"
              name="Line"
              parent="menu_cold_storage_configuration"
              action="action_cold_storage_line"
              sequence="40"/>

    <menuitem id="menu_cold_storage_pocket"
              name="Pocket"
              parent="menu_cold_storage_configuration"
              action="action_cold_storage_pocket"
              sequence="50"/>
</odoo>
