<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Season List View -->
    <record id="view_cold_storage_season_list" model="ir.ui.view">
        <field name="name">cold.storage.season.list</field>
        <field name="model">cold.storage.season</field>
        <field name="arch" type="xml">
            <list string="Seasons" decoration-info="state == 'draft'" decoration-success="state == 'open'" decoration-muted="state == 'closed'">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="default_bag_rate"/>
                <field name="team_id"/>
                <field name="season_manager"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-success="state == 'open'" decoration-muted="state == 'closed'"/>
            </list>
        </field>
    </record>

    <!-- Season Form View -->
    <record id="view_cold_storage_season_form" model="ir.ui.view">
        <field name="name">cold.storage.season.form</field>
        <field name="model">cold.storage.season</field>
        <field name="arch" type="xml">
            <form string="Season">
                <header>
                    <button name="action_open" string="Open Season" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close Season" type="object" class="btn-danger" invisible="state != 'open'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,closed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Season Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Potato Season 2026-27" readonly="state == 'closed'"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Operating Period &amp; Rate">
                            <field name="date_start" readonly="state == 'closed'"/>
                            <field name="date_end" readonly="state == 'closed'"/>
                            <field name="default_bag_rate" readonly="state == 'closed'"/>
                        </group>
                        <group string="Operational Personnel">
                            <field name="team_id" readonly="state == 'closed'" options="{'no_create_edit': False}"/>
                            <field name="season_manager" readonly="state == 'closed'"/>
                        </group>
                    </group>
                    <group string="Season Summary &amp; Stock Statistics">
                        <group>
                            <field name="total_inward_count" readonly="1"/>
                            <field name="total_received_bags" readonly="1"/>
                            <field name="total_released_bags" readonly="1"/>
                        </group>
                        <group>
                            <field name="total_remaining_bags" readonly="1"/>
                            <field name="total_due_amount" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Inwards History" name="inward_history">
                            <field name="inward_ids" readonly="1">
                                <list create="0" delete="0" decoration-danger="remaining_quantity &gt; 0" decoration-success="remaining_quantity == 0 and bag_quantity &gt; 0">
                                    <field name="name" string="Lot Number"/>
                                    <field name="partner_id" string="Customer"/>
                                    <field name="product_name" string="Product"/>
                                    <field name="bag_quantity" string="Received Bags"/>
                                    <field name="released_quantity" string="Released Bags"/>
                                    <field name="remaining_quantity" string="Remaining Bags"/>
                                    <field name="release_status" widget="badge"
                                           decoration-danger="release_status == 'unreleased'"
                                           decoration-warning="release_status == 'partial'"
                                           decoration-success="release_status == 'full'"/>
                                    <field name="payment_status" widget="badge"
                                           decoration-success="payment_status == 'paid'"
                                           decoration-warning="payment_status == 'partial'"
                                           decoration-danger="payment_status == 'due'"
                                           decoration-muted="payment_status == 'no_invoice'"/>
                                    <field name="due_amount" string="Due Amount"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Season Search View -->
    <record id="view_cold_storage_season_search" model="ir.ui.view">
        <field name="name">cold.storage.season.search</field>
        <field name="model">cold.storage.season</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="team_id"/>
                <field name="season_manager"/>
                <filter string="Draft" name="filter_draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Open" name="filter_open" domain="[('state', '=', 'open')]"/>
                <filter string="Closed" name="filter_closed" domain="[('state', '=', 'closed')]"/>
                <group>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Team" name="group_by_team" context="{'group_by': 'team_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Season Window Action -->
    <record id="action_cold_storage_season" model="ir.actions.act_window">
        <field name="name">Season</field>
        <field name="res_model">cold.storage.season</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cold_storage_season_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Cold Storage Season!
            </p>
            <p>
                Track operational periods, default bag rates, assigned teams, and managers.
            </p>
        </field>
    </record>

    <!-- Season Menuitem under Root -->
    <menuitem id="menu_cold_storage_season"
              name="Season"
              parent="menu_cold_storage_root"
              action="action_cold_storage_season"
              sequence="10"/>
</odoo>
