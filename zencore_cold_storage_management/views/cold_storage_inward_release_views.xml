<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Release List View -->
    <record id="view_cold_storage_inward_release_list" model="ir.ui.view">
        <field name="name">cold.storage.inward.release.list</field>
        <field name="model">cold.storage.inward.release</field>
        <field name="arch" type="xml">
            <list string="Product Releases">
                <field name="name" string="Delivery Ref"/>
                <field name="inward_id" string="Inward Lot"/>
                <field name="partner_id"/>
                <field name="date"/>
                <field name="receiver_name"/>
                <field name="quantity" string="Bags"/>
                <field name="bag_rate"/>
                <field name="total_amount" sum="Total Billed"/>
                <field name="move_id" string="Customer Invoice"/>
                <field name="payment_mode" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Release Form View -->
    <record id="view_cold_storage_inward_release_form" model="ir.ui.view">
        <field name="name">cold.storage.inward.release.form</field>
        <field name="model">cold.storage.inward.release</field>
        <field name="arch" type="xml">
            <form string="Product Release Delivery Order">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Delivery Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Lot &amp; Customer Information">
                            <field name="inward_id" options="{'no_create': True}"/>
                            <field name="partner_id"/>
                            <field name="date"/>
                            <field name="receiver_name"/>
                            <field name="vehicle_no"/>
                        </group>
                        <group string="Billing &amp; Financial Summary">
                            <field name="quantity"/>
                            <field name="bag_rate"/>
                            <field name="total_amount"/>
                            <field name="move_id" string="Customer Invoice" options="{'no_create': True}"/>
                            <field name="payment_mode" invisible="not payment_mode"/>
                            <field name="journal_id" invisible="not journal_id"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Remarks / Notes">
                        <field name="notes" nolabel="1" placeholder="Add delivery notes, gate pass remarks..."/>
                    </group>
                    <notebook>
                        <page string="Slot Allocation Breakdown" name="slot_lines">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="slot_id"/>
                                    <field name="quantity" string="Released Bags"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Release Search View -->
    <record id="view_cold_storage_inward_release_search" model="ir.ui.view">
        <field name="name">cold.storage.inward.release.search</field>
        <field name="model">cold.storage.inward.release</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Delivery Ref"/>
                <field name="inward_id"/>
                <field name="partner_id"/>
                <field name="receiver_name"/>
                <group>
                    <filter string="Inward Lot" name="group_by_inward" context="{'group_by': 'inward_id'}"/>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Date" name="group_by_date" context="{'group_by': 'date'}"/>
                    <filter string="Payment Mode" name="group_by_payment_mode" context="{'group_by': 'payment_mode'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Release Window Action -->
    <record id="action_cold_storage_inward_release" model="ir.actions.act_window">
        <field name="name">Releases</field>
        <field name="res_model">cold.storage.inward.release</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cold_storage_inward_release_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first cold storage product release!
            </p>
            <p>
                Manage product outward delivery tickets, slot inventory deduction, and customer billing.
            </p>
        </field>
    </record>

    <!-- Submenu under Inward & lots: Release -->
    <menuitem id="menu_cold_storage_release"
              name="Release"
              parent="menu_cold_storage_inward_root"
              action="action_cold_storage_inward_release"
              sequence="30"/>
</odoo>
