<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Teams List View -->
    <record id="view_cold_storage_team_list" model="ir.ui.view">
        <field name="name">cold.storage.team.list</field>
        <field name="model">cold.storage.team</field>
        <field name="arch" type="xml">
            <list string="Operational Teams">
                <field name="name"/>
                <field name="leader_id"/>
                <field name="member_ids" widget="many2many_tags"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="active" widget="boolean_toggle" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Teams Form View -->
    <record id="view_cold_storage_team_form" model="ir.ui.view">
        <field name="name">cold.storage.team.form</field>
        <field name="model">cold.storage.team</field>
        <field name="arch" type="xml">
            <form string="Operational Team">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Team Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. Operations Team Alpha"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Leadership &amp; Company">
                            <field name="leader_id" options="{'no_create_edit': False, 'no_quick_create': False}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Team Members" name="team_members">
                            <field name="member_ids" widget="many2many">
                                <list string="Members">
                                    <field name="name"/>
                                    <field name="work_email"/>
                                    <field name="work_phone"/>
                                    <field name="job_title"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Teams Search View -->
    <record id="view_cold_storage_team_search" model="ir.ui.view">
        <field name="name">cold.storage.team.search</field>
        <field name="model">cold.storage.team</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="leader_id"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Team Leader" name="group_by_leader" context="{'group_by': 'leader_id'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Teams Window Action -->
    <record id="action_cold_storage_team" model="ir.actions.act_window">
        <field name="name">Teams</field>
        <field name="res_model">cold.storage.team</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cold_storage_team_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Operational Cold Storage Team!
            </p>
            <p>
                Configure teams with designated Team Leaders and members from your company employees.
            </p>
        </field>
    </record>

    <!-- Submenu under Configuration -->
    <menuitem id="menu_cold_storage_team"
              name="Teams"
              parent="menu_cold_storage_configuration"
              action="action_cold_storage_team"
              sequence="60"/>
</odoo>
