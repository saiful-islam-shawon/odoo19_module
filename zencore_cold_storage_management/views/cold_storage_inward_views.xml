<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inward List View -->
    <record id="view_cold_storage_inward_list" model="ir.ui.view">
        <field name="name">cold.storage.inward.list</field>
        <field name="model">cold.storage.inward</field>
        <field name="arch" type="xml">
            <list string="Inward Lots">
                <field name="name" string="Lot Number"/>
                <field name="partner_id" string="Customer"/>
                <field name="product_name" string="Product"/>
                <field name="bag_quantity" string="Total Bags"/>
                <field name="released_quantity" string="Released Bags"/>
                <field name="remaining_quantity" string="Remaining Bags"/>
                <field name="release_status" widget="badge"
                       decoration-danger="release_status == 'unreleased'"
                       decoration-warning="release_status == 'partial'"
                       decoration-success="release_status == 'full'"/>
                <field name="payment_status" widget="badge"
                       decoration-success="payment_status == 'paid'"
                       decoration-warning="payment_status == 'partial'"
                       decoration-danger="payment_status == 'due'"
                       decoration-muted="payment_status == 'no_invoice'"/>
                <field name="due_amount" string="Due"/>
                <field name="bag_rate" string="Bag Rate"/>
                <field name="season_id" string="Season"/>
                <field name="date_start" string="Start Date"/>
                <field name="date_end" string="End Date"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- Inward Form View -->
    <record id="view_cold_storage_inward_form" model="ir.ui.view">
        <field name="name">cold.storage.inward.form</field>
        <field name="model">cold.storage.inward</field>
        <field name="arch" type="xml">
            <form string="Inward Deposit">
                <header>
                    <button name="action_open_release_wizard"
                            string="Release"
                            type="object"
                            class="btn-primary"
                            invisible="remaining_quantity &lt;= 0"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_plottings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-exchange">
                            <field name="plotting_count" widget="statinfo" string="Plotting"/>
                        </button>
                        <button name="action_view_scraps"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-trash-o">
                            <field name="scrap_count" widget="statinfo" string="Scrap"/>
                        </button>
                        <button name="action_view_releases"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck">
                            <field name="release_count" widget="statinfo" string="Release"/>
                        </button>
                        <button name="action_view_invoices"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-money">
                            <field name="invoice_count" widget="statinfo" string="Invoices"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Lot Number"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer &amp; Storage Agreement">
                            <field name="partner_id" options="{'no_create_edit': False, 'no_quick_create': False}"/>
                            <field name="season_id" options="{'no_create_edit': False, 'no_quick_create': False}"/>
                            <field name="bag_rate"/>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                        <group string="Product &amp; Storage Details">
                            <field name="product_name" placeholder="e.g. Cardinal Potato, Granola Seed"/>
                            <field name="bag_quantity"/>
                            <field name="scrapped_quantity" readonly="1"/>
                            <field name="released_quantity" readonly="1"/>
                            <field name="remaining_quantity" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Storage Allocation" name="storage_allocation">
                            <field name="allocation_ids">
                                <list editable="bottom">
                                    <field name="slot_id" string="Storage Slot" options="{'no_create_edit': False, 'no_quick_create': True}"/>
                                    <field name="quantity" string="Allocated Bags" width="180px"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Inward Search View -->
    <record id="view_cold_storage_inward_search" model="ir.ui.view">
        <field name="name">cold.storage.inward.search</field>
        <field name="model">cold.storage.inward</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" string="Lot Number"/>
                <field name="partner_id"/>
                <field name="product_name"/>
                <field name="season_id"/>
                <group>
                    <filter string="Customer" name="group_by_customer" context="{'group_by': 'partner_id'}"/>
                    <filter string="Season" name="group_by_season" context="{'group_by': 'season_id'}"/>
                    <filter string="Start Date" name="group_by_start_date" context="{'group_by': 'date_start'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Inward Window Action -->
    <record id="action_cold_storage_inward" model="ir.actions.act_window">
        <field name="name">Inward &amp; lots</field>
        <field name="res_model">cold.storage.inward</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_cold_storage_inward_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Record your first Cold Storage Inward deposit!
            </p>
            <p>
                Track customer bags, products, storage agreements, and auto-generated unique lot numbers.
            </p>
        </field>
    </record>

    <!-- Submenu 1: Inward & lots under Inward & lots Root -->
    <menuitem id="menu_cold_storage_inward"
              name="Inward &amp; lots"
              parent="menu_cold_storage_inward_root"
              action="action_cold_storage_inward"
              sequence="10"/>
</odoo>
