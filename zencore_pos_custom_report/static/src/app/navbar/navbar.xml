<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="zencore_pos_custom_report.Navbar" t-inherit="point_of_sale.Navbar" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('pos-burger-menu-items')]//DropdownItem[1]" position="after">
            <DropdownItem onSelected="() => this.openWaiterCashierReport()">
                Waiter Cashier Report
            </DropdownItem>
            <DropdownItem onSelected="() => this.openItemsSalesReport()">
                Items Sales Report
            </DropdownItem>
            <DropdownItem onSelected="() => this.openWorkPeriodSalesSummary()">
                Work Period Sales Summary
            </DropdownItem>
        </xpath>
    </t>

</templates>
