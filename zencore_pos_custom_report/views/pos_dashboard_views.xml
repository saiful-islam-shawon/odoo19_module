<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action to open Sessions list strictly filtered by the active POS register card -->
    <record id="action_pos_session_total_reports" model="ir.actions.act_window">
        <field name="name">Total Reports</field>
        <field name="res_model">pos.session</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('config_id', '=', active_id)]</field>
        <field name="context">{
            'search_default_config_id': [active_id],
            'default_config_id': active_id
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No sessions found for this Point of Sale register
            </p>
        </field>
    </record>

    <!-- Inherit POS Config Kanban view to add 'Total Reports' under 'View' in 3-dot dropdown -->
    <record id="view_pos_config_kanban_inherit_total_reports" model="ir.ui.view">
        <field name="name">pos.config.kanban.inherit.total.reports</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_config_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//div[contains(@class, 'o_kanban_manage_view')]" position="inside">
                <div role="menuitem">
                    <a name="%(zencore_pos_custom_report.action_pos_session_total_reports)d" type="action">Total Reports</a>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
