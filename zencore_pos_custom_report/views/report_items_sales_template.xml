<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_items_sales_template" name="Items Sales Report Template">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate"/>
                <meta http-equiv="Pragma" content="no-cache"/>
                <meta http-equiv="Expires" content="0"/>
                <title></title>
                <style>
                    @page {
                        size: A4 portrait;
                        margin: 0;
                    }
                    * {
                        -webkit-print-color-adjust: exact !important;
                        print-color-adjust: exact !important;
                        color-adjust: exact !important;
                        box-sizing: border-box;
                    }
                    body {
                        font-family: Arial, "Helvetica Neue", Helvetica, sans-serif;
                        color: #000000;
                        background-color: #f4f6f8;
                        margin: 0;
                        padding: 20px;
                        font-size: 13px;
                    }
                    .report-wrapper {
                        max-width: 820px;
                        margin: 0 auto;
                        background: #ffffff;
                        padding: 30px 40px;
                        box-shadow: 0 1px 4px rgba(0,0,0,0.15);
                    }
                    .report-header {
                        text-align: center;
                        margin-bottom: 20px;
                    }
                    .report-header .report-title {
                        font-size: 16px;
                        font-weight: bold;
                        margin-bottom: 3px;
                    }
                    .report-header .period-text {
                        font-size: 12px;
                        font-weight: bold;
                        margin-bottom: 3px;
                    }
                    .report-header .config-name {
                        font-size: 13px;
                        font-weight: bold;
                        text-transform: uppercase;
                        margin-bottom: 2px;
                    }
                    .report-header .company-legal {
                        font-size: 12px;
                        font-weight: bold;
                        margin-bottom: 2px;
                    }
                    .report-header .company-address {
                        font-size: 12px;
                        font-weight: bold;
                        margin-bottom: 2px;
                    }
                    .report-header .tax-info {
                        font-size: 12px;
                        font-weight: bold;
                        margin-bottom: 6px;
                    }
                    .export-link-container {
                        text-align: center;
                        margin-bottom: 15px;
                    }
                    .export-link {
                        color: #0066cc;
                        font-size: 13px;
                        font-weight: 500;
                        text-decoration: underline;
                        cursor: pointer;
                        display: inline-block;
                        margin-right: 15px;
                    }
                    .print-btn {
                        background: #6c757d;
                        color: #ffffff;
                        border: none;
                        padding: 3px 12px;
                        font-size: 12px;
                        border-radius: 3px;
                        cursor: pointer;
                    }
                    .report-table {
                        width: 100%;
                        border-collapse: collapse;
                        margin-bottom: 20px;
                        font-size: 12px;
                    }
                    .report-table th, .report-table td {
                        border: 1px solid #777777;
                        padding: 4px 8px;
                    }
                    .table-main-header {
                        background-color: #707070 !important;
                        color: #ffffff !important;
                        font-weight: bold;
                        text-align: center;
                        font-size: 13px;
                        border: 1px solid #707070 !important;
                    }
                    .table-sub-header th {
                        background-color: #707070 !important;
                        color: #ffffff !important;
                        font-weight: bold;
                        font-size: 12px;
                        border: 1px solid #777777;
                    }
                    .total-row td {
                        font-weight: bold;
                    }
                    .text-left {
                        text-align: left;
                    }
                    .text-center {
                        text-align: center;
                    }
                    .text-right {
                        text-align: right;
                    }
                    .report-footer {
                        font-size: 11px;
                        color: #333333;
                        margin-top: 25px;
                        line-height: 1.5;
                    }
                    .report-footer .disclaimer {
                        margin-bottom: 2px;
                    }
                    .report-footer .print-time {
                        margin-bottom: 2px;
                    }
                    .report-footer .powered-by {
                        margin-top: 2px;
                    }
                    @media print {
                        html, body {
                            background-color: #ffffff !important;
                            margin: 0 !important;
                            padding: 0 !important;
                        }
                        .report-wrapper {
                            box-shadow: none !important;
                            margin: 0 !important;
                            padding: 12mm 15mm !important;
                            max-width: 100% !important;
                            width: 100% !important;
                        }
                        .export-link-container {
                            display: none !important;
                        }
                    }
                </style>
            </head>
            <body>
                <div class="report-wrapper">
                    <!-- Actions (Hidden in Print) -->
                    <div class="export-link-container">
                        <a t-attf-href="/pos/items_sales_report/export_xlsx?config_id={{ config.id if config else '' }}&amp;session_id={{ session_id or '' }}" class="export-link">
                            Export Data
                        </a>
                        <button onclick="window.print()" class="print-btn">
                            Print
                        </button>
                    </div>

                    <!-- Header -->
                    <div class="report-header">
                        <div class="report-title">Item Sales Report</div>
                        <t t-if="session_name">
                            <div class="period-text">
                                Session: <t t-esc="session_name"/> (<t t-esc="session_state"/>)
                            </div>
                        </t>
                        <div class="period-text">
                            Period: <t t-esc="period_string"/>
                        </div>
                        <div class="config-name">
                            <t t-esc="config.name if config else company.name"/>
                        </div>
                        <t t-if="company and company.name and config and company.name != config.name">
                            <div class="company-legal">
                                <t t-esc="company.name"/>
                            </div>
                        </t>
                        <div class="company-address">
                            <t t-if="company.partner_id.city">
                                <t t-esc="company.partner_id.city"/>
                            </t>
                            <t t-if="company.partner_id.zip">
                                -<t t-esc="company.partner_id.zip"/>,
                            </t>
                            <t t-if="company.partner_id.country_id">
                                <t t-esc="company.partner_id.country_id.name"/>
                            </t>
                        </div>
                        <div class="tax-info">
                            <t t-if="company.vat">
                                Central BIN-<t t-esc="company.vat"/>, MUSAK-6.3
                            </t>
                            <t t-else="">
                                Central BIN-000466455-0100, MUSAK-6.3
                            </t>
                        </div>
                    </div>

                    <!-- Table 1: Sales by Item Group -->
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th colspan="4" class="table-main-header">Sales by Item Group</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="sales_by_group" t-as="group">
                                <tr>
                                    <td class="text-left" style="width: 35%;">
                                        <t t-esc="group['name']"/>
                                    </td>
                                    <td class="text-right" style="width: 20%;">
                                        <t t-esc="group['percentage_formatted']"/>
                                    </td>
                                    <td class="text-right" style="width: 25%;">
                                        <t t-esc="group['gross_formatted']"/>
                                    </td>
                                    <td class="text-right" style="width: 20%;">
                                        <t t-esc="group['net_formatted']"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="total-row">
                                <td class="text-left"></td>
                                <td class="text-right">Total</td>
                                <td class="text-right">
                                    <t t-esc="total_group_gross_formatted"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="total_group_net_formatted"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Table 2: Quantities by Item Group -->
                    <table class="report-table">
                        <thead>
                            <tr>
                                <th colspan="3" class="table-main-header">Quantities by Item Group</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="qty_by_group" t-as="group">
                                <tr>
                                    <td class="text-left" style="width: 45%;">
                                        <t t-esc="group['name']"/>
                                    </td>
                                    <td class="text-right" style="width: 25%;">
                                        <t t-esc="group['qty_percentage_formatted']"/>
                                    </td>
                                    <td class="text-right" style="width: 30%;">
                                        <t t-esc="group['qty_formatted']"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="total-row">
                                <td class="text-left">Total</td>
                                <td class="text-right"></td>
                                <td class="text-right">
                                    <t t-esc="total_group_qty_formatted"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Table 3: Product Detail Breakdown -->
                    <table class="report-table">
                        <thead>
                            <tr class="table-sub-header">
                                <th class="text-center" style="width: 20%;">Category</th>
                                <th class="text-center" style="width: 25%;">Product</th>
                                <th class="text-center" style="width: 15%;">Portion</th>
                                <th class="text-center" style="width: 13%;">Price</th>
                                <th class="text-center" style="width: 12%;">Quantity</th>
                                <th class="text-center" style="width: 15%;">Net-Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="product_details" t-as="item">
                                <tr>
                                    <td class="text-left">
                                        <t t-esc="item['category']"/>
                                    </td>
                                    <td class="text-left">
                                        <t t-esc="item['product']"/>
                                    </td>
                                    <td class="text-left">
                                        <t t-esc="item['portion']"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="item['price_formatted']"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="item['qty_formatted']"/>
                                    </td>
                                    <td class="text-right">
                                        <t t-esc="item['amount_formatted']"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="total-row">
                                <td class="text-left" colspan="4">Total</td>
                                <td class="text-right">
                                    <t t-esc="total_product_qty_formatted"/>
                                </td>
                                <td class="text-right">
                                    <t t-esc="total_product_amount_formatted"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Footer -->
                    <div class="report-footer">
                        <div class="disclaimer">
                            *** This is computer generated report and does not require any signature
                        </div>
                        <div class="print-time">
                            Print Date Time: <t t-esc="print_datetime_str"/>
                        </div>
                        <div class="powered-by">
                            Powered by: 3S
                        </div>
                    </div>
                </div>
            </body>
        </html>
    </template>
</odoo>
