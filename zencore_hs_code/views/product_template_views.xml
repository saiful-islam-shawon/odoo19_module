<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_hs_code" model="ir.ui.view">
        <field name="name">product.template.form.inherit.hs.code</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock_delivery.product_template_hs_code"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='hs_code']" position="replace">
                <field name="hs_code_id" string="HS Code" options="{'no_create': True}"/>
            </xpath>
        </field>
    </record>
</odoo>
