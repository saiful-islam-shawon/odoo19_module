<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_zencore_hs_code_list" model="ir.ui.view">
        <field name="name">zencore.hs.code.list</field>
        <field name="model">zencore.hs.code</field>
        <field name="arch" type="xml">
            <list string="HS Codes">
                <field name="hscode"/>
                <field name="tariff_description"/>
                <field name="cd" widget="percentage"/>
                <field name="sd" widget="percentage"/>
                <field name="vat" widget="percentage"/>
                <field name="ait" widget="percentage"/>
                <field name="at" widget="percentage"/>
                <field name="rd" widget="percentage"/>
            </list>
        </field>
    </record>

    <record id="view_zencore_hs_code_form" model="ir.ui.view">
        <field name="name">zencore.hs.code.form</field>
        <field name="model">zencore.hs.code</field>
        <field name="arch" type="xml">
            <form string="HS Code">
                <sheet>

                    <group string="HS Code Information" col="2">

                        <group>
                            <field name="hscode"
                                   placeholder="e.g. 10001"/>

                            <field name="tariff_description"
                                   placeholder="Enter tariff description..."/>
                        </group>

                        <group>
                            <field name="cd" widget="percentage"/>
                            <field name="sd" widget="percentage"/>
                            <field name="vat" widget="percentage"/>
                            <field name="ait" widget="percentage"/>
                            <field name="at" widget="percentage"/>
                            <field name="rd" widget="percentage"/>
                        </group>

                    </group>

                </sheet>
            </form>
        </field>
    </record>

    <record id="view_zencore_hs_code_search" model="ir.ui.view">
        <field name="name">zencore.hs.code.search</field>
        <field name="model">zencore.hs.code</field>
        <field name="arch" type="xml">
            <search string="Search HS Codes">
                <field name="hscode"/>
                <field name="tariff_description"/>
            </search>
        </field>
    </record>

    <record id="action_zencore_hs_code" model="ir.actions.act_window">
        <field name="name">HS Codes</field>
        <field name="res_model">zencore.hs.code</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_zencore_hs_code_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first HS Code
            </p>
        </field>
    </record>

    <menuitem
        id="menu_zencore_hs_code_root"
        name="HS Code"
        sequence="10"
    />

    <menuitem
        id="menu_zencore_hs_code"
        name="HS Codes"
        parent="menu_zencore_hs_code_root"
        action="action_zencore_hs_code"
        sequence="10"
    />

</odoo>
