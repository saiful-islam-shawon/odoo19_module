<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_purchase_order_form_hs_code_rates" model="ir.ui.view">
        <field name="name">purchase.order.form.hs.code.rates</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='tax_ids']" position="after">
                <field name="hs_cd" widget="monetary" optional="show"/>
                <field name="hs_sd" widget="monetary" optional="show"/>
                <field name="hs_vat" widget="monetary" optional="show"/>
                <field name="hs_ait" widget="monetary" optional="show"/>
                <field name="hs_at" widget="monetary" optional="show"/>
                <field name="hs_rd" widget="monetary" optional="show"/>
            </xpath>
            <!-- tax_totals has no label; span both columns so the duty rows below stay aligned -->
            <xpath expr="//field[@name='tax_totals']" position="attributes">
                <attribute name="colspan">2</attribute>
            </xpath>
            </field>
    </record>
</odoo>
