<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_purchase_hs_duty" model="report.paperformat">
        <field name="name">Purchase HS Duty Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">25</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">5</field>
        <field name="margin_right">5</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">8</field>
        <field name="dpi">110</field>
    </record>
    <record id="action_report_purchase_hs_duty" model="ir.actions.report">
        <field name="name">Purchase HS Duty Report</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zencore_hs_code.report_purchase_hs_duty_document</field>
        <field name="report_file">zencore_hs_code.report_purchase_hs_duty_document</field>
        <field name="paperformat_id" ref="paperformat_purchase_hs_duty"/>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'HS Duty - %s' % (object.name)</field>
    </record>
</odoo>
