<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="action_print_official_mushak_43" model="ir.actions.server">
    <field name="name">Mushak 4.3 — QWeb Print</field>
    <field name="model_id" ref="zsl_vat.model_vat_io_coefficient"/>
    <field name="binding_model_id" eval="False"/><field name="state">code</field>
    <field name="code">action = records.action_print_mushak_43()</field>
  </record>
  <record id="action_report_mushak_43" model="ir.actions.report"><field name="name">Mushak 4.3 — Input-Output Coefficient</field><field name="model">vat.io.coefficient</field><field name="report_type">qweb-pdf</field><field name="report_name">zsl_vat.report_mushak_43</field><field name="report_file">zsl_vat.report_mushak_43</field><field name="binding_model_id" ref="model_vat_io_coefficient"/><field name="binding_type">report</field></record>
  <template id="report_mushak_43"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="form_code" t-value="'Mushak 4.3'"/><t t-set="form_title" t-value="'Input-Output Coefficient Declaration'"/><t t-call="zsl_vat.mushak_qweb_layout"><div class="zsl-mushak-section"><h4>Finished product and coefficient declaration</h4><table class="zsl-mushak-table"><tr><td class="zsl-mushak-label">Reference</td><td><span t-field="o.name"/></td><td class="zsl-mushak-label">Effective date</td><td><span t-field="o.effective_date"/></td></tr><tr><td class="zsl-mushak-label">Finished product</td><td><span t-field="o.product_tmpl_id"/></td><td class="zsl-mushak-label">Output quantity / wastage</td><td><span t-field="o.output_qty"/> / <span t-field="o.wastage_percent"/>%</td></tr><tr><td class="zsl-mushak-label">Material cost</td><td><span t-field="o.material_cost"/></td><td class="zsl-mushak-label">Declared price</td><td><span t-field="o.declared_price"/></td></tr></table></div><div class="zsl-mushak-section"><h4>Input materials</h4><table class="zsl-mushak-table"><tr><th>SL</th><th>Material</th><th>Quantity</th><th>UoM</th><th>Unit cost</th><th>Total</th></tr><tr t-foreach="o.line_ids" t-as="line"><td><span t-esc="line_index + 1"/></td><td><span t-field="line.product_id"/></td><td class="zsl-mushak-number"><span t-field="line.quantity"/></td><td><span t-field="line.uom_id"/></td><td class="zsl-mushak-number"><span t-field="line.unit_cost"/></td><td class="zsl-mushak-number"><span t-field="line.subtotal"/></td></tr></table></div></t></t></t></template>
</odoo>
