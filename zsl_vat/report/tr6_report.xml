<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="action_print_official_treasury_challan" model="ir.actions.server">
    <field name="name">TR-6 — QWeb Print</field>
    <field name="model_id" ref="zsl_vat.model_vat_treasury_payment"/>
    <field name="binding_model_id" eval="False"/><field name="state">code</field>
    <field name="code">action = records.action_print_treasury_challan()</field>
  </record>
  <record id="action_report_tr6" model="ir.actions.report"><field name="name">TR-6 — Treasury Challan</field><field name="model">vat.treasury.payment</field><field name="report_type">qweb-pdf</field><field name="report_name">zsl_vat.report_tr6</field><field name="report_file">zsl_vat.report_tr6</field><field name="binding_model_id" ref="model_vat_treasury_payment"/><field name="binding_type">report</field></record>
  <template id="report_tr6"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="form_code" t-value="'TR-6'"/><t t-set="form_title" t-value="'Treasury Challan'"/><t t-call="zsl_vat.mushak_qweb_layout"><div class="zsl-mushak-section"><h4>Government receipt / treasury payment details</h4><table class="zsl-mushak-table"><tr><td class="zsl-mushak-label">Challan no. / date</td><td><span t-field="o.challan_number"/> / <span t-field="o.payment_date"/></td><td class="zsl-mushak-label">Payment status</td><td><span t-field="o.state"/></td></tr><tr><td class="zsl-mushak-label">Depositor</td><td><span t-field="o.company_id.name"/><br/><span t-field="o.company_id.vat_bin"/></td><td class="zsl-mushak-label">VAT unit</td><td><span t-field="o.unit_id"/></td></tr><tr><td class="zsl-mushak-label">Bank</td><td><span t-field="o.bank"/></td><td class="zsl-mushak-label">Economic code</td><td><span t-field="o.economic_code"/></td></tr><tr><td class="zsl-mushak-label">Payment type</td><td><span t-field="o.payment_type"/></td><td class="zsl-mushak-label">VAT return</td><td><span t-field="o.return_id.name"/></td></tr><tr><th>Amount paid</th><th colspan="3" class="zsl-mushak-number"><span t-field="o.amount"/></th></tr></table></div><div class="zsl-mushak-section"><h4>Certificate / payment allocation</h4><table class="zsl-mushak-table"><tr><th>VDS Certificate</th><th>Supplier / party</th><th>Base amount</th><th>VDS amount</th></tr><tr t-foreach="o.vds_certificate_ids" t-as="certificate"><td><span t-field="certificate.name"/></td><td><span t-field="certificate.partner_id"/></td><td class="zsl-mushak-number"><span t-field="certificate.base_amount"/></td><td class="zsl-mushak-number"><span t-field="certificate.amount"/></td></tr></table></div></t></t></t></template>
</odoo>
