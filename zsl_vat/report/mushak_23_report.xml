<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_mushak_23_portrait" model="report.paperformat">
        <field name="name">Mushak 2.3 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">24</field>
        <field name="margin_left">34</field>
        <field name="margin_right">34</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_print_official_mushak_23" model="ir.actions.server">
        <field name="name">Mushak 2.3 — QWeb Print</field>
        <field name="model_id" ref="zsl_vat.model_vat_registration_certificate"/>
        <field name="binding_model_id" eval="False"/>
        <field name="state">code</field>
        <field name="code">action = records.action_print_certificate()</field>
    </record>

    <record id="action_report_mushak_23" model="ir.actions.report">
        <field name="name">Mushak 2.3 — Registration Certificate</field>
        <field name="model">vat.registration.certificate</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zsl_vat.report_mushak_23</field>
        <field name="report_file">zsl_vat.report_mushak_23</field>
        <field name="binding_model_id" ref="model_vat_registration_certificate"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_mushak_23_portrait"/>
    </record>

    <template id="report_mushak_23">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <div class="page mushak-23-page">
                        <style type="text/css">
                            * {
                                box-sizing: border-box;
                            }
                            @page {
                                size: A4 portrait;
                                margin: 30mm 34mm 24mm 34mm;
                            }
                            body {
                                margin: 0;
                                padding: 0;
                            }
                            .mushak-23-page {
                                font-family: 'Nikosh', 'Noto Sans Bengali', Arial, sans-serif !important;
                                color: #000;
                                width: 100%;
                                line-height: 1.35;
                                font-size: 9.5pt;
                            }
                            .mushak-23-header {
                                text-align: center;
                                position: relative;
                                margin-bottom: 22px;
                            }
                            .mushak-23-emblem {
                                position: absolute;
                                left: 8px;
                                top: 2px;
                                width: 52px;
                                height: 52px;
                            }
                            .mushak-23-badge {
                                position: absolute;
                                right: 0px;
                                top: 24px;
                                border: 1px solid #000;
                                padding: 4px 16px;
                                font-weight: bold;
                                font-size: 9.5pt;
                                background: #fff;
                            }
                            .mushak-23-green-title {
                                text-align: center;
                                font-weight: bold;
                                font-size: 10pt;
                                color: #008000;
                                text-decoration: underline;
                                margin-bottom: 22px;
                            }
                            .mushak-23-intro {
                                font-size: 9.5pt;
                                line-height: 1.45;
                                margin-bottom: 20px;
                                text-align: left;
                            }
                            .mushak-23-subhead {
                                text-align: center;
                                font-weight: bold;
                                text-decoration: underline;
                                font-size: 9.5pt;
                                margin-bottom: 18px;
                            }
                            .mushak-23-info-table {
                                width: 100%;
                                border-collapse: collapse;
                                border: none;
                                font-size: 9.5pt;
                            }
                            .mushak-23-info-table td {
                                border: none;
                                padding: 3.5px 2px;
                                vertical-align: middle;
                            }
                            .digit-grid {
                                border-collapse: collapse;
                                display: inline-table;
                                vertical-align: middle;
                            }
                            .digit-grid td {
                                border: 1px solid #000 !important;
                                width: 16px;
                                height: 22px;
                                padding: 0 !important;
                                text-align: center;
                            }
                            .mushak-23-notice {
                                margin: 24px 0 24px 14px;
                                font-size: 9.5pt;
                            }
                            .mushak-23-qr-box {
                                margin: 0 auto;
                                width: 118px;
                                height: 42px;
                                border: 1px solid #000;
                                text-align: center;
                                line-height: 40px;
                                font-size: 9.5pt;
                            }
                        </style>

                        <!-- Header with Color Emblem, Authority Info, and মূসক-২.৩ Badge -->
                        <div class="mushak-23-header">
                            <img class="mushak-23-emblem" src="data:image/jpeg;base64,"/>
                            <div style="font-size: 9.5pt; line-height: 1.35;">গণপ্রজাতন্ত্রী বাংলাদেশ সরকার</div>
                            <div style="font-size: 9.5pt; line-height: 1.35;">জাতীয় রাজস্ব বোর্ড</div>
                            <div style="font-size: 9.5pt; line-height: 1.35;">কাস্টমস, এক্সাইজ ও ভ্যাট কমিশনারেট, .....</div>
                            <div style="font-size: 9.5pt; line-height: 1.35;">......বিভাগ</div>
                            <div style="font-size: 9.5pt; line-height: 1.35;">[ বিধি ৪ এর উপ-বিধি (৪) দ্রষ্টব্য]</div>
                            <div class="mushak-23-badge">মূসক-২.৩</div>
                        </div>

                        <!-- Green Underlined Title -->
                        <div class="mushak-23-green-title">
                            মূল্য সংযোজন কর নিবন্ধন সনদপত্র/টার্নওভার কর তালিকাভুক্তি সনদপত্র
                        </div>

                        <!-- Certification Paragraph -->
                        <div class="mushak-23-intro">
                            প্রত্যয়ন করা যাইতেছে যে, নিম্নে বর্ণিত করদাতা মূল্য সংযোজন কর ও সম্পূরক শুল্ক আইন, ২০১২ (২০১২ সনের ৪৭ নং আইন) এর অধীন নিবন্ধিত/তালিকাভুক্ত।
                        </div>

                        <!-- Subheading -->
                        <div class="mushak-23-subhead">
                            নিবন্ধিত/তালিকাভুক্ত করদাতার সংক্ষিপ্তবিবরণ
                        </div>

                        <!-- 10-Row Taxpayer Summary -->
                        <table class="mushak-23-info-table">
                            <colgroup>
                                <col style="width: 36%;"/>
                                <col style="width: 4%;"/>
                                <col style="width: 60%;"/>
                            </colgroup>
                            <tr>
                                <td style="padding-left: 14px;">নাম</td>
                                <td style="text-align: center;">:</td>
                                <td><span t-esc="o.taxpayer_name or o.company_id.vat_legal_name or o.company_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">বিআইএন</td>
                                <td style="text-align: center;">:</td>
                                <td style="padding-left: 62px;">
                                    <table class="digit-grid" style="margin-left: 8px;">
                                        <tr>
                                            <td colspan="9"><span t-esc="o.bin or ''"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">পুরাতন বিআইএন (যদি থাকে)</td>
                                <td style="text-align: center;">:</td>
                                <td style="padding-left: 62px;">
                                    <table class="digit-grid">
                                        <tr>
                                            <td colspan="11"><span t-esc="o.company_id.vat_legacy_bin or ''"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">e-TIN (যদি থাকে)</td>
                                <td style="text-align: center;">:</td>
                                <td style="padding-left: 62px;">
                                    <table class="digit-grid">
                                        <tr>
                                            <td colspan="12"><span t-esc="o.application_id.tin or o.company_id.vat_tin or ''"/></td>
                                        </tr>
                                    </table>
                                </td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">ঠিকানা</td>
                                <td style="text-align: center;">:</td>
                                <td><span t-esc="o.registered_address or o.company_id.vat_registered_address or o.company_id.partner_id.contact_address or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">ইস্যুর তারিখ</td>
                                <td style="text-align: center;">:</td>
                                <td><span t-esc="o.issue_date.strftime('%d-%m-%Y') if o.issue_date else ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">কার্যকারিতার তারিখ</td>
                                <td style="text-align: center;">:</td>
                                <td><span t-esc="o.effective_date.strftime('%d-%m-%Y') if o.effective_date else ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">ব্যবসার প্রকৃতি</td>
                                <td style="text-align: center;">:</td>
                                <td><span t-esc="dict(o._fields['registration_type'].selection).get(o.registration_type, '')"/></td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">অর্থনৈতিক কার্যক্রমের প্রকৃতি</td>
                                <td style="text-align: center;">:</td>
                                <td><span t-esc="o.application_id.business_activity or o.company_id.vat_business_nature or ''"/></td>
                            </tr>
                            <tr>
                                <td style="padding-left: 14px;">অর্থনৈতিক কার্যক্রমকোড ও বিবরণ</td>
                                <td style="text-align: center;">:</td>
                                <td><span t-esc="o.certificate_reference or ''"/></td>
                            </tr>
                        </table>

                        <!-- System Notice & QR Code Box -->
                        <div class="mushak-23-notice">
                            This is a system generated certificate and requires no signature
                        </div>
                        <div class="mushak-23-qr-box">QR Code</div>

                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
