<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_mushak_61_landscape" model="report.paperformat">
        <field name="name">Mushak 6.1 Landscape</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">44</field>
        <field name="margin_bottom">35</field>
        <field name="margin_left">42</field>
        <field name="margin_right">22</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_print_official_mushak_61" model="ir.actions.server">
        <field name="name">Mushak 6.1 — QWeb Print</field>
        <field name="model_id" ref="zsl_vat.model_vat_book_wizard"/>
        <field name="state">code</field>
        <field name="code">action = records.with_context(default_book_type='purchase').action_print()</field>
    </record>

    <record id="action_report_mushak_61" model="ir.actions.report">
        <field name="name">Mushak 6.1 — Purchase Book</field>
        <field name="model">vat.book.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zsl_vat.report_mushak_61</field>
        <field name="report_file">zsl_vat.report_mushak_61</field>
        <field name="paperformat_id" ref="paperformat_mushak_61_landscape"/>
    </record>

    <template id="report_mushak_61">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <style type="text/css">
                        @page {
                            size: A4 landscape;
                            margin: 44mm 22mm 35mm 42mm;
                        }
                        body {
                            margin: 0;
                            padding: 0;
                        }
                        .mushak-61-page {
                            font-family: 'Nikosh', 'Noto Sans Bengali', Arial, sans-serif !important;
                            color: #000;
                            width: 100%;
                            line-height: 1.15;
                        }
                        .mushak-61-page-break {
                            page-break-before: always;
                            break-before: page;
                        }
                        .mushak-61-header-box {
                            width: 100%;
                            border: 1px solid #000;
                            border-bottom: none;
                            padding: 6px 8px 8px 8px;
                            box-sizing: border-box;
                            position: relative;
                        }
                        .mushak-61-product-box {
                            position: absolute;
                            top: 8px;
                            left: 8px;
                            border: 1px solid #000;
                            padding: 4px 10px;
                            font-weight: bold;
                            font-size: 10.5pt;
                            text-align: center;
                            min-width: 60px;
                            max-width: 24%;
                            word-wrap: break-word;
                        }
                            .mushak-61-badge-container {
                                width: 100%;
                                text-align: right;
                                margin-bottom: 2px;
                            }
                            .mushak-61-badge {
                                display: inline-block;
                                font-weight: bold;
                                font-size: 10pt;
                            }
                            .mushak-61-title-block {
                                text-align: center;
                                margin-top: 2px;
                            }
                            .mushak-61-title-1 {
                                font-size: 10.5pt;
                                font-weight: bold;
                                line-height: 1.25;
                            }
                            .mushak-61-title-2 {
                                font-size: 11pt;
                                font-weight: bold;
                                line-height: 1.25;
                                margin-top: 1px;
                            }
                            .mushak-61-title-3 {
                                font-size: 10pt;
                                font-weight: bold;
                                line-height: 1.25;
                                margin-top: 1px;
                            }
                            .mushak-61-title-4 {
                                font-size: 10pt;
                                font-weight: bold;
                                line-height: 1.25;
                                margin-top: 1px;
                            }
                            .mushak-61-title-5 {
                                font-size: 10pt;
                                font-weight: bold;
                                line-height: 1.25;
                                margin-top: 2px;
                            }
                            .mushak-61-table {
                                width: 100%;
                                border-collapse: collapse;
                                border: 1px solid #000;
                                table-layout: fixed;
                            }
                            .mushak-61-table thead {
                                display: table-row-group;
                            }
                            .mushak-61-table tr {
                                page-break-inside: avoid;
                                break-inside: avoid;
                            }
                            .mushak-61-table th, .mushak-61-table td {
                                border: 1px solid #000;
                                padding: 2px 1px;
                                text-align: center;
                                vertical-align: top;
                                word-wrap: break-word;
                                font-size: 7.5pt;
                                line-height: 1.15;
                            }
                            .mushak-61-table th {
                                font-weight: bold;
                                background-color: #fff;
                            }
                            .mushak-61-num-row th {
                                font-size: 7pt !important;
                                font-weight: normal !important;
                                vertical-align: middle !important;
                                padding: 2px 0 !important;
                                background-color: #fff !important;
                            }
                            .mushak-61-data-row td {
                                height: 20px;
                                padding: 1px;
                                font-size: 6.5pt;
                            }
                            .mushak-61-empty-cell {
                                vertical-align: middle !important;
                                text-align: center !important;
                            }
                            .mushak-61-notes {
                                margin-top: 6px;
                                font-size: 8.5pt;
                                line-height: 1.2;
                                text-align: left;
                                page-break-inside: avoid;
                                break-inside: avoid;
                            }
                            .mushak-61-notes-title {
                                font-weight: bold;
                                margin-bottom: 3px;
                            }
                            .mushak-61-notes-item {
                                padding-left: 28px;
                                text-indent: -28px;
                                margin-bottom: 2px;
                            }
                        </style>

                    <t t-set="raw_rows" t-value="o.env['zsl_vat.official.mushak.pdf']._mushak_61_rows(o)"/>
                    <t t-set="unique_prods" t-value="[]"/>
                    <t t-foreach="raw_rows" t-as="r">
                        <t t-set="p_pair" t-value="(r['product'].id if r.get('product') else (r.get('description') or ''), (r['product'].name if r.get('product') else '') or r.get('description') or '')"/>
                        <t t-if="p_pair not in unique_prods">
                            <t t-set="unique_prods" t-value="unique_prods + [p_pair]"/>
                        </t>
                    </t>
                    <t t-if="not unique_prods">
                        <t t-set="unique_prods" t-value="[('__empty__', '')]"/>
                    </t>

                    <t t-foreach="unique_prods" t-as="up">
                        <t t-set="grp_rows" t-value="[r for r in raw_rows if (r['product'].id if r.get('product') else (r.get('description') or '')) == up[0]]"/>
                        <t t-set="serial_start" t-value="sum(len([r for r in raw_rows if (r['product'].id if r.get('product') else (r.get('description') or '')) == prev[0]]) for prev in unique_prods[:up_index])"/>
                        <div t-attf-class="page mushak-61-page {{ 'mushak-61-page-break' if up_index != 0 else '' }}">

                            <!-- Statutory Header Box -->
                            <div class="mushak-61-header-box">
                                <div t-if="up[1]" class="mushak-61-product-box"><t t-esc="up[1]"/></div>
                                <div class="mushak-61-badge-container">
                                    <div class="mushak-61-badge">মূসক-৬.১</div>
                                </div>
                            <div class="mushak-61-title-block">
                                <div class="mushak-61-title-1">প্রতিষ্ঠানের নাম, ঠিকানা ও ব্যবসা সনাক্তকরণ সংখ্যা</div>
                                <div class="mushak-61-title-2">ক্রয় হিসাব পুস্তক</div>
                                <div class="mushak-61-title-3">(পণ্য বা সেবা প্রক্রিয়াকরণে সম্পৃক্ত এমন নিবন্ধিত বা তালিকাভুক্ত ব্যক্তির জন্য প্রযোজ্য)</div>
                                <div class="mushak-61-title-4">[বিধি ৪০(১) এর দফা (ক) এবং ৪১ এর দফা (ক) দ্রষ্টব্য]</div>
                                <div class="mushak-61-title-5">পণ্য/সেবার উপকরণ ক্রয়</div>
                            </div>
                        </div>

                        <!-- 21-Column Table -->
                        <table class="mushak-61-table">
                            <colgroup>
                                <col style="width: 3.82%;"/>
                                <col style="width: 4.26%;"/>
                                <col style="width: 4.75%;"/>
                                <col style="width: 4.78%;"/>
                                <col style="width: 5.95%;"/>
                                <col style="width: 4.23%;"/>
                                <col style="width: 4.07%;"/>
                                <col style="width: 6.22%;"/>
                                <col style="width: 6.78%;"/>
                                <col style="width: 4.58%;"/>
                                <col style="width: 5.72%;"/>
                                <col style="width: 4.81%;"/>
                                <col style="width: 5.93%;"/>
                                <col style="width: 3.89%;"/>
                                <col style="width: 4.77%;"/>
                                <col style="width: 4.11%;"/>
                                <col style="width: 3.58%;"/>
                                <col style="width: 3.26%;"/>
                                <col style="width: 5.39%;"/>
                                <col style="width: 5.18%;"/>
                                <col style="width: 3.92%;"/>
                            </colgroup>
                            <thead>
                                <!-- Tier 1 Header -->
                                <tr>
                                    <th rowspan="3">ক্রমিক<br/>সংখ্যা</th>
                                    <th rowspan="3">তারিখ</th>
                                    <th colspan="2">মজুদ উপকরণের<br/>প্রারম্ভিক জের</th>
                                    <th colspan="14">ক্রয়কৃত উপকরণ</th>
                                    <th colspan="2">উপকরণের প্রান্তিক জের</th>
                                    <th rowspan="3">মন্তব্য</th>
                                </tr>
                                <!-- Tier 2 Header -->
                                <tr>
                                    <!-- Under মজুদ উপকরণের প্রারম্ভিক জের -->
                                    <th rowspan="2">পরিমাণ<br/>(একক)</th>
                                    <th rowspan="2">মূল্য<br/>(সকল<br/>প্রকার<br/>কর<br/>ব্যতীত)</th>

                                    <!-- Under ক্রয়কৃত উপকরণ -->
                                    <th rowspan="2">চালানপত্র/<br/>বিল অব<br/>এন্ট্রি নম্বর</th>
                                    <th rowspan="2">তারিখ</th>
                                    <th colspan="3">বিক্রেতা/ সরবরাহকারী</th>
                                    <th rowspan="2">বিবরণ</th>
                                    <th rowspan="2">পরিমাণ</th>
                                    <th rowspan="2">মূল্য<br/>(সকল<br/>প্রকার<br/>কর<br/>ব্যতীত)</th>
                                    <th rowspan="2">সম্পূরকশুল্ক<br/>(যদি<br/>থাকে)</th>
                                    <th rowspan="2">মূসক</th>
                                    <th colspan="2">মোট উপকরণের<br/>পরিমাণ</th>
                                    <th colspan="2">পণ্য<br/>প্রস্তুত/প্রক্রিয়া<br/>করণে<br/>উপকরণের<br/>ব্যবহার</th>

                                    <!-- Under উপকরণের প্রান্তিক জের -->
                                    <th rowspan="2">পরিমাণ<br/>(একক)</th>
                                    <th rowspan="2">মূল্য<br/>(সকল<br/>প্রকার<br/>কর<br/>ব্যতীত)</th>
                                </tr>
                                <!-- Tier 3 Header -->
                                <tr>
                                    <!-- Under বিক্রেতা/ সরবরাহকারী -->
                                    <th>নাম</th>
                                    <th>ঠিকানা</th>
                                    <th>নিবন্ধন/<br/>তালিকাভুক্তি/<br/>জাতীয়<br/>পরিচয়পত্র নং</th>

                                    <!-- Under মোট উপকরণের পরিমাণ -->
                                    <th>পরিমাণ<br/>(একক)</th>
                                    <th>মূল্য<br/>(সকল<br/>প্রকার<br/>কর<br/>ব্যতীত)</th>

                                    <!-- Under পণ্য প্রস্তুত/প্রক্রিয়াকরণে উপকরণের ব্যবহার -->
                                    <th>পরিমাণ<br/>(একক)</th>
                                    <th>মূল্য<br/>(সকল<br/>প্রকার<br/>কর<br/>ব্যতীত)</th>
                                </tr>
                                <!-- Tier 4 Column Numbering Row -->
                                <tr class="mushak-61-num-row">
                                    <th>(১)</th>
                                    <th>(২)</th>
                                    <th>(৩)</th>
                                    <th>(৪)</th>
                                    <th>(৫)</th>
                                    <th>(৬)</th>
                                    <th>(৭)</th>
                                    <th>(৮)</th>
                                    <th>(৯)</th>
                                    <th>(১০)</th>
                                    <th>(১১)</th>
                                    <th>(১২)</th>
                                    <th>(১৩)</th>
                                    <th>(১৪)</th>
                                    <th>(১৫)<br/>=(৩+১১)</th>
                                    <th>(১৬)<br/>=(৪+১২)</th>
                                    <th>(১৭)</th>
                                    <th>(১৮)</th>
                                    <th>(১৯)</th>
                                    <th>(২০)</th>
                                    <th>(২১)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="grp_rows">
                                    <t t-foreach="grp_rows" t-as="row">
                                        <t t-set="col_2_date" t-value="row.get('opening_effective_date') if row_index == 0 else row.get('date')"/>
                                        <t t-set="txt" t-value="{
                                            'date': col_2_date.strftime('%d-%m-%Y') if col_2_date else '',
                                            'doc': str(row.get('document') or '').strip(),
                                            'doc_date': row['document_date'].strftime('%d-%m-%Y') if row.get('document_date') else '',
                                            'partner': str(row.get('partner') or '').strip(),
                                            'address': str(row.get('address') or '').strip(),
                                            'tax_id': str(row.get('supplier_tax_id') or '').strip(),
                                            'desc': str(row.get('description') or '').strip(),
                                            'remarks': str(row.get('remarks') or '').strip(),
                                        }"/>
                                        <tr class="mushak-61-data-row">
                                            <td><t t-esc="serial_start + row_index + 1"/></td>
                                            <td t-att-class="'' if txt['date'] else 'mushak-61-empty-cell'"><t t-esc="txt['date'] or '--'"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('opening_qty') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('opening_value') or 0.0)"/></td>
                                            <td t-att-class="'' if txt['doc'] else 'mushak-61-empty-cell'"><t t-esc="txt['doc'] or '--'"/></td>
                                            <td t-att-class="'' if txt['doc_date'] else 'mushak-61-empty-cell'"><t t-esc="txt['doc_date'] or '--'"/></td>
                                            <td t-att-class="'' if txt['partner'] else 'mushak-61-empty-cell'"><t t-esc="txt['partner'] or '--'"/></td>
                                            <td t-att-class="'' if txt['address'] else 'mushak-61-empty-cell'"><t t-esc="txt['address'] or '--'"/></td>
                                            <td t-att-class="'' if txt['tax_id'] else 'mushak-61-empty-cell'"><t t-esc="txt['tax_id'] or '--'"/></td>
                                            <td t-att-class="'' if txt['desc'] else 'mushak-61-empty-cell'"><t t-esc="txt['desc'] or '--'"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('purchase_qty') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('purchase_value') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('sd') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('vat') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('total_qty') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('total_value') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('used_qty') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('used_value') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('closing_qty') or 0.0)"/></td>
                                            <td><t t-esc="'{:,.2f}'.format(row.get('closing_value') or 0.0)"/></td>
                                            <td t-att-class="'' if txt['remarks'] else 'mushak-61-empty-cell'"><t t-esc="txt['remarks'] or '--'"/></td>
                                        </tr>
                                    </t>
                                </t>
                                <t t-else="">
                                    <!-- Exact single blank row when no transactions exist -->
                                    <tr class="mushak-61-data-row">
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                        <td>&#160;</td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Statutory Footnotes (বিশেষ দ্রষ্টব্যঃ) -->
                        <div class="mushak-61-notes">
                            <div class="mushak-61-notes-title">বিশেষ দ্রষ্টব্যঃ</div>
                            <div class="mushak-61-notes-item">১।  অর্থনৈতিক কার্যক্রম সংশ্লিষ্ট সকল প্রকার ক্রয়ের তথ্য এই ফরমে অন্তর্ভুক্ত করিতে হইবে।</div>
                            <div class="mushak-61-notes-item">২।  যে ক্ষেত্রে অনিবন্ধিত ব্যক্তির নিকট হইতে পণ্য ক্রয় করা হইবে সেই ক্ষেত্রে উক্ত ব্যক্তির পূর্ণাঙ্গ নাম, ঠিকানা ও জাতীয় পরিচয়পত্র নম্বর যথাযথভাবে সংশ্লিষ্ট কলাম [(৭), (৮) ও (৯)] এ আবশ্যিকভাবে উল্লেখ করিতে হইবে।</div>
                            <div class="mushak-61-notes-item">৩।  উপকরণ ক্রয়ের স্বপক্ষে প্রামাণিক দলিল হিসাবে বিল অব এন্ট্রি বা চালানপত্রের কপি সংরক্ষণ করিতে হইবে।</div>
                        </div>

                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
