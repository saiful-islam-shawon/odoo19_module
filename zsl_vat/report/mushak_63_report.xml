<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="action_print_official_mushak_63" model="ir.actions.server">
    <field name="name">Mushak 6.3 — QWeb Print</field>
    <field name="model_id" ref="account.model_account_move"/>
    <field name="binding_model_id" eval="False"/><field name="state">code</field>
    <field name="code">action = records.action_print_mushak_63()</field>
  </record>
  <record id="action_report_mushak_63" model="ir.actions.report"><field name="name">Mushak 6.3 — Tax Invoice</field><field name="model">account.move</field><field name="report_type">qweb-pdf</field><field name="report_name">zsl_vat.report_mushak_63</field><field name="report_file">zsl_vat.report_mushak_63</field><field name="binding_model_id" ref="account.model_account_move"/><field name="binding_type">report</field></record>
  <template id="report_mushak_63"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="form_code" t-value="'Mushak 6.3'"/><t t-set="form_title" t-value="'Tax Invoice'"/><t t-call="zsl_vat.mushak_qweb_layout"><div class="zsl-mushak-section"><h4>Supplier and recipient information</h4><table class="zsl-mushak-table"><tr><td class="zsl-mushak-label">Invoice / Mushak no.</td><td><span t-field="o.name"/> / <span t-field="o.vat_mushak_number"/></td><td class="zsl-mushak-label">Issue date</td><td><span t-field="o.invoice_date"/></td></tr><tr><td class="zsl-mushak-label">Supplier</td><td><span t-field="o.company_id.name"/><br/><span t-field="o.company_id.vat_bin"/></td><td class="zsl-mushak-label">Recipient</td><td><span t-field="o.partner_id"/><br/><span t-field="o.partner_id.vat_bin"/></td></tr><tr><td class="zsl-mushak-label">VAT unit</td><td><span t-field="o.vat_unit_id"/></td><td class="zsl-mushak-label">Supply type</td><td><span t-field="o.vat_supply_type"/></td></tr></table></div><div class="zsl-mushak-section"><h4>Goods / service details</h4><table class="zsl-mushak-table"><tr><th>SL</th><th>Description</th><th>HS / service code</th><th>UoM</th><th>Qty</th><th>Rate</th><th>Taxable value</th><th>VAT</th><th>SD</th></tr><tr t-foreach="o.invoice_line_ids" t-as="line" t-if="not line.display_type"><td><span t-esc="line_index + 1"/></td><td><span t-field="line.name"/></td><td><span t-field="line.product_id.product_tmpl_id.vat_hs_code_id"/></td><td><span t-field="line.product_uom_id"/></td><td class="zsl-mushak-number"><span t-field="line.quantity"/></td><td class="zsl-mushak-number"><span t-field="line.price_unit"/></td><td class="zsl-mushak-number"><span t-field="line.price_subtotal"/></td><td class="zsl-mushak-number"><span t-esc="line.price_total - line.price_subtotal"/></td><td class="zsl-mushak-number">—</td></tr><tr><th colspan="6">Total</th><th class="zsl-mushak-number"><span t-field="o.vat_taxable_amount"/></th><th class="zsl-mushak-number"><span t-field="o.vat_output_amount"/></th><th class="zsl-mushak-number"><span t-field="o.vat_sd_amount"/></th></tr></table></div></t></t></t></template>
</odoo>
