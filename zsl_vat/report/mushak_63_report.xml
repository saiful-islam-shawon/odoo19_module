<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="paperformat_mushak_63_portrait" model="report.paperformat">
        <field name="name">Mushak 6.3 Portrait</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">34</field>
        <field name="margin_bottom">24</field>
        <field name="margin_left">32</field>
        <field name="margin_right">32</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_print_official_mushak_63" model="ir.actions.server">
        <field name="name">Mushak 6.3 — QWeb Print</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" eval="False"/>
        <field name="state">code</field>
        <field name="code">action = records.action_print_mushak_63()</field>
    </record>

    <record id="action_report_mushak_63" model="ir.actions.report">
        <field name="name">Mushak 6.3 — Tax Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">zsl_vat.report_mushak_63</field>
        <field name="report_file">zsl_vat.report_mushak_63</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_mushak_63_portrait"/>
    </record>

    <!--
        Compatibility cleanup: early builds created an inherited QR overlay
        with an XPath for a heading that no longer exists in the 6.3 layout.
        Keep the former XML id, but replace and disable that view so upgrading
        an existing database cannot retain the invalid inherited architecture.
    -->
    <record id="report_mushak_63_qr" model="ir.ui.view">
        <field name="name">report_mushak_63_qr_retired</field>
        <field name="type">qweb</field>
        <field name="inherit_id" eval="False"/>
        <field name="active" eval="False"/>
        <field name="arch" type="xml">
            <t t-name="zsl_vat.report_mushak_63_qr_retired"/>
        </field>
    </record>

    <template id="report_mushak_63">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id">
                    <div class="page mushak-63-page">
                        <style type="text/css">
                            * {
                                box-sizing: border-box;
                            }
                            @page {
                                size: A4 portrait;
                                margin: 34mm 32mm 24mm 32mm;
                            }
                            body {
                                margin: 0;
                                padding: 0;
                            }
                            .mushak-63-page {
                                font-family: 'Nikosh', 'Noto Sans Bengali', Arial, sans-serif !important;
                                color: #000;
                                width: 100%;
                                line-height: 1.3;
                                font-size: 9pt;
                            }
                            .mushak-63-header {
                                text-align: center;
                                position: relative;
                                margin-bottom: 12px;
                            }
                            .mushak-63-emblem {
                                position: absolute;
                                left: 32px;
                                top: 0px;
                                width: 48px;
                                height: 48px;
                            }
                            .mushak-63-badge {
                                position: absolute;
                                right: 20px;
                                top: 10px;
                                border: 1.5px solid #000;
                                padding: 3px 12px;
                                font-weight: bold;
                                font-size: 10.5pt;
                                background: #fff;
                            }
                            .mushak-63-supplier-wrap {
                                width: 100%;
                                margin-bottom: 10px;
                            }
                            .mushak-63-supplier-box {
                                margin-left: 34%;
                                line-height: 1.45;
                                font-size: 9pt;
                            }
                            .mushak-63-info-grid {
                                width: 100%;
                                border-collapse: collapse;
                                border: none;
                                margin-bottom: 14px;
                                font-size: 9pt;
                                line-height: 1.45;
                            }
                            .mushak-63-info-grid td {
                                border: none;
                                padding: 1px 0;
                                vertical-align: top;
                            }
                            .mushak-63-table {
                                width: 100%;
                                border-collapse: collapse;
                                border: 1px solid #000;
                                table-layout: fixed;
                                font-size: 8.5pt;
                                line-height: 1.2;
                            }
                            .mushak-63-table th,
                            .mushak-63-table td {
                                border: 1px solid #000;
                                padding: 3px 3px;
                                vertical-align: middle;
                                word-wrap: break-word;
                            }
                            .mushak-63-table th {
                                text-align: center;
                                font-weight: normal;
                                background-color: #fff;
                            }
                            .mushak-63-data-row td {
                                height: 17px;
                            }
                            .mushak-63-total-row td {
                                height: 17px;
                            }
                            .mushak-63-signatory {
                                margin-top: 16px;
                                line-height: 1.5;
                                font-size: 9pt;
                            }
                            .mushak-63-asterisk-note {
                                margin-top: 14px;
                                line-height: 1.4;
                                font-size: 9pt;
                            }
                            .mushak-63-bottom-rule {
                                width: 26%;
                                height: 0;
                                font-size: 0;
                                line-height: 0;
                                border: none !important;
                                border-top: 1px solid #000 !important;
                                margin: 110px 0 4px 0;
                            }
                            .mushak-63-bottom-note {
                                font-size: 8pt;
                                line-height: 1.3;
                            }
                            .text-center { text-align: center; }
                            .text-right { text-align: right; }
                            .text-left { text-align: left; }
                        </style>

                        <!-- Header with Monochrome Emblem, Gov Title, and মূসক-৬.৩ Badge -->
                        <div class="mushak-63-header">
                            <img class="mushak-63-emblem" src="data:image/png;base64," alt="BD Emblem"/>
                            <div style="font-size: 10.5pt; font-weight: normal; margin-bottom: 1px;">গণপ্রজাতন্ত্রী বাংলাদেশ সরকার</div>
                            <div style="font-size: 11pt; font-weight: bold; margin-bottom: 8px;">জাতীয় রাজস্ব বোর্ড</div>
                            <div class="mushak-63-badge">মূসক-৬.৩</div>
                            <div style="font-size: 10.5pt; font-weight: bold; margin-bottom: 4px;">কর চালানপত্র</div>
                            <div style="font-size: 9.5pt; font-weight: bold;">[ বিধি ৪০ এর উপ-বিধি (১) এর দফা (গ) ও দফা (চ) দ্রষ্টব্য ]</div>
                        </div>

                        <!-- Supplier Block -->
                        <div class="mushak-63-supplier-wrap">
                            <div class="mushak-63-supplier-box">
                                <div>নিবন্ধিত ব্যক্তির নাম: <span t-esc="o.company_id.vat_legal_name or o.company_id.name"/></div>
                                <div>নিবন্ধিত ব্যক্তির বিআইএন: <span t-esc="o.company_id.vat_bin or ''"/></div>
                                <div>চালানপত্র ইস্যুর ঠিকানা: <span t-esc="o.company_id.partner_id.contact_address or ''"/></div>
                            </div>
                        </div>

                        <!-- Buyer & Challan Info -->
                        <table class="mushak-63-info-grid">
                            <colgroup>
                                <col style="width: 67%;"/>
                                <col style="width: 33%;"/>
                            </colgroup>
                            <tr>
                                <td>ক্রেতার নাম: <span t-esc="o.partner_id.name or ''"/></td>
                                <td>চালানপত্র নম্বর: <span t-esc="o.vat_mushak_number or o.name"/></td>
                            </tr>
                            <tr>
                                <td>ক্রেতার বিআইএন: <span t-esc="o.partner_id.vat_bin or ''"/></td>
                                <td>ইস্যুর তারিখ: <span t-esc="o.invoice_date.strftime('%d-%m-%Y') if o.invoice_date else ''"/></td>
                            </tr>
                            <tr>
                                <td>সরবরাহের গন্তব্যস্থল: <span t-esc="o.partner_id.contact_address or ''"/></td>
                                <td>ইস্যুর সময়: <span t-esc="context_timestamp(o.create_date).strftime('%I:%M %p') if o.create_date else ''"/></td>
                            </tr>
                        </table>

                        <!-- 10-Column Table -->
                        <table class="mushak-63-table">
                            <colgroup>
                                <col style="width: 5.5%;"/>
                                <col style="width: 10.5%;"/>
                                <col style="width: 10.0%;"/>
                                <col style="width: 7.5%;"/>
                                <col style="width: 9.0%;"/>
                                <col style="width: 9.0%;"/>
                                <col style="width: 11.0%;"/>
                                <col style="width: 12.5%;"/>
                                <col style="width: 13.5%;"/>
                                <col style="width: 11.5%;"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th>ক্রমিক</th>
                                    <th>পণ্য বা<br/>সেবার<br/>বর্ণনা<br/>(প্রযোজ্য<br/>ক্ষেত্রে<br/>ব্র্যান্ড<br/>নামসহ)</th>
                                    <th>সরবরাহের<br/>একক</th>
                                    <th>পরিমাণ</th>
                                    <th>একক<br/>মূল্য<sup>১</sup><br/>(টাকায়)</th>
                                    <th>মোট<br/>মূল্য<sup>১</sup><br/>(টাকায়)</th>
                                    <th>সম্পূরক<br/>শুল্কের<br/>পরিমাণ<br/>(টাকায়)</th>
                                    <th>মূল্য<br/>সংযোজন<br/>করের<br/>হার/<br/>সুনির্দিষ্ট<br/>কর</th>
                                    <th>মূল্য<br/>সংযোজন<br/>কর/<br/>সুনির্দিষ্ট<br/>কর এর<br/>পরিমাণ<br/>(টাকায়)</th>
                                    <th>সকল<br/>প্রকার<br/>শুল্ক ও<br/>করসহ<br/>মূল্য</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="mushak-63-data-row" t-foreach="o.invoice_line_ids.filtered(lambda line: line.display_type == 'product')" t-as="line">
                                    <td class="text-center"><span t-esc="line_index + 1"/></td>
                                    <td><span t-esc="line.product_id.display_name or line.name"/></td>
                                    <td class="text-center"><span t-esc="line.product_uom_id.name or ''"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % line.quantity"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % line.price_unit"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % line.price_subtotal"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % line._vat_tax_components()[1]"/></td>
                                    <td class="text-center"><span t-esc="', '.join(line.tax_ids.mapped('name')) or '-'"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % (line.price_total - line.price_subtotal)"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % line.price_total"/></td>
                                </tr>
                                <tr class="mushak-63-total-row">
                                    <td colspan="5" class="text-right" style="padding-right: 6px;">সর্বমোট</td>
                                    <td class="text-right"><span t-esc="'%.2f' % o.amount_untaxed"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % o.vat_sd_amount"/></td>
                                    <td class="text-center">-</td>
                                    <td class="text-right"><span t-esc="'%.2f' % o.amount_tax"/></td>
                                    <td class="text-right"><span t-esc="'%.2f' % o.amount_total"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Signatory Block -->
                        <div class="mushak-63-signatory">
                            <div>প্রতিষ্ঠান কর্তৃপক্ষের দায়িত্বপ্রাপ্ত ব্যক্তির নাম:</div>
                            <div>পদবী :</div>
                            <div>স্বাক্ষর:</div>
                            <div>সীল:</div>
                        </div>

                        <!-- Asterisk Note -->
                        <div class="mushak-63-asterisk-note">
                            * উৎসে কর্তনযোগ্য সরবরাহের ক্ষেত্রে ফরমটি সমন্বিত কর চালানপত্র ও উৎসে কর কর্তন সনদপত্র হিসেবে বিবেচিত হইবে এবং উহা উৎসে কর কর্তনযোগ্য সরবরাহের ক্ষেত্রে প্রযোজ্য হইবে।
                        </div>

                        <!-- Bottom Rule and Footnote -->
                        <div class="mushak-63-bottom-rule"></div>
                        <div class="mushak-63-bottom-note">
                            <sup>১</sup> সকল প্রকার কর ব্যতীত মূল্য” ;
                        </div>

                    </div>
                </div>
            </t>
        </t>
    </template>

</odoo>
