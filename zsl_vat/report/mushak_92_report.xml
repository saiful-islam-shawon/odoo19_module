<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="action_print_official_mushak_92" model="ir.actions.server">
    <field name="name">Mushak 9.2 — QWeb Print</field>
    <field name="model_id" ref="zsl_vat.model_vat_return"/>
    <field name="state">code</field>
    <field name="code">action = records.action_print_mushak_return()</field>
  </record>
  <record id="action_report_mushak_92" model="ir.actions.report"><field name="name">Mushak 9.2 — Turnover Tax Return</field><field name="model">vat.return</field><field name="report_type">qweb-pdf</field><field name="report_name">zsl_vat.report_mushak_92</field><field name="report_file">zsl_vat.report_mushak_92</field><field name="binding_model_id" ref="model_vat_return"/><field name="binding_type">report</field></record>
  <template id="report_mushak_92"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="form_code" t-value="'Mushak 9.2'"/><t t-set="form_title" t-value="'Turnover Tax Return'"/><t t-call="zsl_vat.mushak_qweb_layout"><div class="zsl-mushak-section"><h4>Taxpayer and period</h4><table class="zsl-mushak-table"><tr><td class="zsl-mushak-label">Taxpayer / BIN</td><td><span t-field="o.company_id.name"/> / <span t-field="o.company_id.vat_bin"/></td><td class="zsl-mushak-label">Return no.</td><td><span t-field="o.name"/></td></tr><tr><td class="zsl-mushak-label">Period</td><td><span t-field="o.period_id.date_start"/> to <span t-field="o.period_id.date_end"/></td><td class="zsl-mushak-label">Unit</td><td><span t-field="o.unit_id"/></td></tr></table></div><div class="zsl-mushak-section"><h4>Turnover summary</h4><table class="zsl-mushak-table"><tr><th>Particulars</th><th>Amount</th></tr><tr><td>Taxable turnover</td><td class="zsl-mushak-number"><span t-field="o.output_vat"/></td></tr><tr><td>Adjustments / credit</td><td class="zsl-mushak-number"><span t-field="o.adjustments_amount"/></td></tr><tr><td>Payable turnover tax</td><td class="zsl-mushak-number"><span t-field="o.net_payable"/></td></tr></table></div><div class="zsl-mushak-section"><h4>Transaction schedule</h4><table class="zsl-mushak-table"><tr><th>Date</th><th>Document no.</th><th>Customer</th><th>Turnover</th></tr><tr t-foreach="o.line_ids" t-as="line"><td><span t-field="line.document_date"/></td><td><span t-field="line.mushak_number"/></td><td><span t-field="line.partner_id"/></td><td class="zsl-mushak-number"><span t-field="line.base_amount"/></td></tr></table></div></t></t></t></template>
</odoo>
