<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="action_print_official_mushak_91" model="ir.actions.server">
    <field name="name">Mushak 9.1 — QWeb Print</field>
    <field name="model_id" ref="zsl_vat.model_vat_return"/>
    <field name="binding_model_id" eval="False"/><field name="state">code</field>
    <field name="code">action = records.action_print_mushak_return()</field>
  </record>
  <record id="action_report_mushak_91" model="ir.actions.report"><field name="name">Mushak 9.1 — VAT Return</field><field name="model">vat.return</field><field name="report_type">qweb-pdf</field><field name="report_name">zsl_vat.report_mushak_91</field><field name="report_file">zsl_vat.report_mushak_91</field><field name="binding_model_id" ref="model_vat_return"/><field name="binding_type">report</field></record>
  <template id="report_mushak_91"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="form_code" t-value="'Mushak 9.1'"/><t t-set="form_title" t-value="'Monthly VAT Return'"/><t t-call="zsl_vat.mushak_qweb_layout"><div class="zsl-mushak-section"><h4>Registered person and tax period</h4><table class="zsl-mushak-table"><tr><td class="zsl-mushak-label">Registered person / BIN</td><td><span t-field="o.company_id.name"/> / <span t-field="o.company_id.vat_bin"/></td><td class="zsl-mushak-label">VAT unit</td><td><span t-field="o.unit_id"/></td></tr><tr><td class="zsl-mushak-label">Return no. / type</td><td><span t-field="o.name"/> / <span t-field="o.return_type"/></td><td class="zsl-mushak-label">Tax period</td><td><span t-field="o.period_id.date_start"/> to <span t-field="o.period_id.date_end"/></td></tr></table></div><div class="zsl-mushak-section"><h4>VAT computation</h4><table class="zsl-mushak-table"><tr><th>Particulars</th><th>Amount</th><th>Particulars</th><th>Amount</th></tr><tr><td>Output VAT</td><td class="zsl-mushak-number"><span t-field="o.output_vat"/></td><td>Input tax credit</td><td class="zsl-mushak-number"><span t-field="o.input_vat"/></td></tr><tr><td>Supplementary duty</td><td class="zsl-mushak-number"><span t-field="o.sd_amount"/></td><td>VDS suffered</td><td class="zsl-mushak-number"><span t-field="o.vds_suffered"/></td></tr><tr><td>Reverse charge VAT</td><td class="zsl-mushak-number"><span t-field="o.reverse_charge_vat"/></td><td>Adjustments</td><td class="zsl-mushak-number"><span t-field="o.adjustments_amount"/></td></tr><tr><td>Opening balance</td><td class="zsl-mushak-number"><span t-field="o.opening_balance"/></td><td>Late interest / fine</td><td class="zsl-mushak-number"><span t-field="o.late_interest"/> / <span t-field="o.late_fine"/></td></tr><tr><th>Net payable</th><th class="zsl-mushak-number"><span t-field="o.net_payable"/></th><th>Closing credit</th><th class="zsl-mushak-number"><span t-field="o.closing_credit"/></th></tr></table></div><div class="zsl-mushak-section"><h4>Transaction schedule</h4><table class="zsl-mushak-table"><tr><th>Date</th><th>Document no.</th><th>Party</th><th>Supply</th><th>Value</th><th>Output VAT</th><th>Input VAT</th><th>SD</th></tr><tr t-foreach="o.line_ids" t-as="line"><td><span t-field="line.document_date"/></td><td><span t-field="line.mushak_number"/></td><td><span t-field="line.partner_id"/></td><td><span t-field="line.supply_type"/></td><td class="zsl-mushak-number"><span t-field="line.base_amount"/></td><td class="zsl-mushak-number"><span t-field="line.output_vat"/></td><td class="zsl-mushak-number"><span t-field="line.input_vat"/></td><td class="zsl-mushak-number"><span t-field="line.sd_amount"/></td></tr></table></div></t></t></t></template>
</odoo>
