<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <record id="action_print_official_mushak_64" model="ir.actions.server">
    <field name="name">Mushak 6.4 — QWeb Print</field>
    <field name="model_id" ref="stock.model_stock_picking"/>
    <field name="state">code</field>
    <field name="code">action = records.action_print_vat_challan()</field>
  </record>
  <record id="action_report_mushak_64" model="ir.actions.report"><field name="name">Mushak 6.4 — Contract Manufacturing Challan</field><field name="model">stock.picking</field><field name="report_type">qweb-pdf</field><field name="report_name">zsl_vat.report_mushak_64</field><field name="report_file">zsl_vat.report_mushak_64</field><field name="binding_model_id" ref="stock.model_stock_picking"/><field name="binding_type">report</field></record>
  <template id="report_mushak_64"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-set="form_code" t-value="'Mushak 6.4'"/><t t-set="form_title" t-value="'Contract Manufacturing Challan'"/><t t-call="zsl_vat.mushak_qweb_layout"><div class="zsl-mushak-section"><h4>Sending and receiving party</h4><table class="zsl-mushak-table"><tr><td class="zsl-mushak-label">Challan no. / date</td><td><span t-field="o.vat_challan_number"/> / <span t-field="o.vat_challan_date"/></td><td class="zsl-mushak-label">Reference</td><td><span t-field="o.name"/></td></tr><tr><td class="zsl-mushak-label">Sender</td><td><span t-field="o.vat_unit_id"/><br/><span t-field="o.vat_unit_id.address"/></td><td class="zsl-mushak-label">Receiver</td><td><span t-field="o.partner_id"/><br/><span t-field="o.partner_id.contact_address"/></td></tr><tr><td class="zsl-mushak-label">Remarks</td><td colspan="3"><span t-field="o.vat_remarks"/></td></tr></table></div><div class="zsl-mushak-section"><table class="zsl-mushak-table"><tr><th>SL</th><th>Description / HS code</th><th>UoM</th><th>Quantity</th><th>Value excl. tax</th></tr><tr t-foreach="o.move_ids" t-as="move"><td><span t-esc="move_index + 1"/></td><td><span t-field="move.product_id"/> / <span t-field="move.product_id.product_tmpl_id.vat_hs_code_id"/></td><td><span t-field="move.product_uom"/></td><td class="zsl-mushak-number"><span t-field="move.quantity"/></td><td class="zsl-mushak-number"><span t-esc="move.quantity * move.product_id.standard_price"/></td></tr><tr><th colspan="4">Total</th><th class="zsl-mushak-number"><span t-field="o.vat_transfer_value"/></th></tr></table></div></t></t></t></template>
</odoo>
