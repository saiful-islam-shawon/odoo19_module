<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_zsl_vat" model="ir.module.category">
        <field name="name">Bangladesh VAT</field><field name="sequence">30</field>
    </record>
    <record id="privilege_zsl_vat" model="res.groups.privilege">
        <field name="name">Bangladesh VAT</field><field name="category_id" ref="module_category_zsl_vat"/>
    </record>
    <record id="group_vat_user" model="res.groups">
        <field name="name">VAT User</field><field name="sequence">10</field><field name="privilege_id" ref="privilege_zsl_vat"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="group_vat_officer" model="res.groups">
        <field name="name">VAT Officer</field><field name="sequence">20</field><field name="privilege_id" ref="privilege_zsl_vat"/>
        <field name="implied_ids" eval="[(4, ref('group_vat_user'))]"/>
    </record>
    <record id="group_vat_manager" model="res.groups">
        <field name="name">VAT Manager</field><field name="sequence">30</field><field name="privilege_id" ref="privilege_zsl_vat"/>
        <field name="implied_ids" eval="[(4, ref('group_vat_officer'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>
    <record id="rule_vat_unit_company" model="ir.rule">
        <field name="name">VAT records: allowed companies</field><field name="model_id" ref="model_vat_unit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_vat_user'))]"/>
    </record>
</odoo>
