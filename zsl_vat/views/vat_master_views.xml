  <record id="action_vat_period" model="ir.actions.act_window"><field name="name">VAT Periods</field><field name="res_model">vat.period</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_document_series_list" model="ir.ui.view"><field name="name">vat.document.series.list</field><field name="model">vat.document.series</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="unit_id"/><field name="document_type"/><field name="sequence_id"/><field name="active"/></list></field></record>
