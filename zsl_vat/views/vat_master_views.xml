  <record id="view_vat_hs_code_form" model="ir.ui.view"><field name="name">vat.hs.code.form</field><field name="model">vat.hs.code</field><field name="arch" type="xml"><form><sheet><group><group><field name="code"/><field name="code_type"/><field name="name"/><field name="chapter"/></group><group><field name="vat_uom_id"/><field name="treatment"/><field name="legal_reference"/><field name="active"/></group></group><notebook><page string="Tax Rules"><field name="tax_rule_ids"><list editable="bottom"><field name="sequence" widget="handle"/><field name="name"/><field name="tax_head"/><field name="calculation"/><field name="rate"/><field name="truncated_base_percent" optional="hide"/><field name="date_from"/><field name="date_to"/><field name="account_tax_id"/><field name="return_note"/></list></field></page></notebook></sheet></form></field></record>
