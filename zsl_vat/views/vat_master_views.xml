  <record id="view_vat_tax_rule_form" model="ir.ui.view"><field name="name">vat.tax.rule.form</field><field name="model">vat.tax.rule</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name" placeholder="e.g. Purchase VAT 15%"/></h1></div><group><group><field name="zencore_hs_code_id"/><field name="hs_code_id"/><field name="tax_head"/><field name="calculation"/><field name="rate"/><field name="truncated_base_percent" invisible="calculation != 'truncated'"/></group><group><field name="account_tax_id" required="1"/><field name="date_from"/><field name="date_to"/><field name="sequence"/><field name="active"/></group></group><group string="Applicability"><field name="purchase_applicable"/><field name="sale_applicable"/><field name="creditable"/><field name="price_include_sd"/></group><group><field name="return_note"/><field name="sro_reference"/></group></sheet></form></field></record>
  <record id="action_vat_tax_rule" model="ir.actions.act_window"><field name="name">VAT Tax Rules</field><field name="res_model">vat.tax.rule</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_unit_list" model="ir.ui.view"><field name="name">vat.unit.list</field><field name="model">vat.unit</field><field name="arch" type="xml"><list><field name="name"/><field name="code"/><field name="unit_type"/><field name="bin"/><field name="company_id"/><field name="active"/></list></field></record>
  <record id="view_vat_unit_form" model="ir.ui.view"><field name="name">vat.unit.form</field><field name="model">vat.unit</field><field name="arch" type="xml"><form><sheet><div class="oe_title"><h1><field name="name"/></h1></div><group><group><field name="code"/><field name="company_id"/><field name="unit_type"/><field name="registration_scope"/><field name="bin" invisible="registration_scope == 'sub_location'" required="registration_scope == 'separate_bin'"/><field name="legacy_bin" invisible="registration_scope == 'sub_location'"/></group><group><field name="business_type_ids" widget="many2many_tags"/><field name="warehouse_ids" widget="many2many_tags"/><field name="user_ids" widget="many2many_tags"/><field name="active"/></group></group><group><field name="address" placeholder="VAT registered address or branch/depot sub-location address"/></group></sheet><chatter/></form></field></record>
  <record id="action_vat_unit" model="ir.actions.act_window"><field name="name">VAT Units</field><field name="res_model">vat.unit</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_period_list" model="ir.ui.view"><field name="name">vat.period.list</field><field name="model">vat.period</field><field name="arch" type="xml"><list><field name="name"/><field name="unit_id"/><field name="date_start"/><field name="date_end"/><field name="due_date"/><field name="state"/></list></field></record>
