  <record id="view_vat_io_coefficient_list" model="ir.ui.view"><field name="name">vat.io.coefficient.list</field><field name="model">vat.io.coefficient</field><field name="arch" type="xml"><list><field name="name"/><field name="product_tmpl_id"/><field name="effective_date"/><field name="material_cost"/><field name="declared_price"/><field name="state"/></list></field></record>
  <record id="view_vat_io_coefficient_form" model="ir.ui.view"><field name="name">vat.io.coefficient.form</field><field name="model">vat.io.coefficient</field><field name="arch" type="xml"><form><header><button name="action_load_bom" type="object" string="Load BOM" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" invisible="state != 'draft'" groups="zsl_vat.group_vat_officer"/><button name="action_print_mushak_43" type="object" string="Print Official Mushak 4.3"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="name"/><field name="product_tmpl_id"/><field name="bom_id"/><field name="effective_date"/></group><group><field name="output_qty"/><field name="wastage_percent"/><field name="value_addition"/><field name="material_cost" readonly="1"/><field name="declared_price" readonly="1"/></group></group><field name="line_ids"><list editable="bottom"><field name="product_id"/><field name="quantity"/><field name="uom_id"/><field name="unit_cost"/><field name="subtotal" readonly="1"/></list></field></sheet><chatter/></form></field></record>
  <record id="action_vat_io_coefficient" model="ir.actions.act_window"><field name="name">Input-Output Coefficients</field><field name="res_model">vat.io.coefficient</field><field name="view_mode">list,form</field></record>
