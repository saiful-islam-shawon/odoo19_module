  <record id="action_vat_document_series" model="ir.actions.act_window"><field name="name">Mushak Numbering</field><field name="res_model">vat.document.series</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_holiday_list" model="ir.ui.view"><field name="name">vat.holiday.list</field><field name="model">vat.holiday</field><field name="arch" type="xml"><list editable="bottom"><field name="date"/><field name="name"/><field name="company_id"/><field name="active"/></list></field></record>
  <record id="view_vat_holiday_form" model="ir.ui.view"><field name="name">vat.holiday.form</field><field name="model">vat.holiday</field><field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="date"/><field name="name"/><field name="active"/></group></sheet></form></field></record>
  <record id="action_vat_holiday" model="ir.actions.act_window"><field name="name">VAT Calendar Holidays</field><field name="res_model">vat.holiday</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_price_declaration_list" model="ir.ui.view"><field name="name">vat.price.declaration.list</field><field name="model">vat.price.declaration</field><field name="arch" type="xml"><list><field name="name"/><field name="product_tmpl_id"/><field name="unit_id"/><field name="effective_date"/><field name="declared_price"/><field name="state"/></list></field></record>
  <record id="view_vat_price_declaration_form" model="ir.ui.view"><field name="name">vat.price.declaration.form</field><field name="model">vat.price.declaration</field><field name="arch" type="xml"><form><header><button name="action_approve" type="object" string="Approve" invisible="state != 'draft'" groups="zsl_vat.group_vat_officer"/><field name="state" widget="statusbar"/></header><sheet><group><field name="name"/><field name="product_tmpl_id"/><field name="unit_id"/><field name="effective_date"/><field name="declared_price"/><field name="approval_reference"/><field name="attachment_ids" widget="many2many_binary"/></group></sheet><chatter/></form></field></record>
