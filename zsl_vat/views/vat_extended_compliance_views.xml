<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_vat_account_mapping_list" model="ir.ui.view">
    <field name="name">vat.account.mapping.list</field><field name="model">vat.account.mapping</field>
    <field name="arch" type="xml"><list><field name="company_id"/><field name="unit_id"/><field name="tax_head"/><field name="account_id"/><field name="journal_id"/><field name="legal_reference"/><field name="active"/></list></field>
  </record>
  <record id="view_vat_account_mapping_form" model="ir.ui.view">
    <field name="name">vat.account.mapping.form</field><field name="model">vat.account.mapping</field>
    <field name="arch" type="xml"><form><sheet><group><field name="company_id"/><field name="unit_id"/><field name="tax_head"/><field name="account_id"/><field name="journal_id"/><field name="legal_reference"/><field name="active"/></group></sheet></form></field>
  </record>
  <record id="action_vat_account_mapping" model="ir.actions.act_window"><field name="name">VAT Accounting Mappings</field><field name="res_model">vat.account.mapping</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_reconciliation_list" model="ir.ui.view">
    <field name="name">vat.reconciliation.list</field><field name="model">vat.reconciliation</field>
    <field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="unit_id"/><field name="period_id"/><field name="return_id"/><field name="difference_amount"/><field name="state"/></list></field>
  </record>
  <record id="view_vat_reconciliation_form" model="ir.ui.view">
    <field name="name">vat.reconciliation.form</field><field name="model">vat.reconciliation</field>
    <field name="arch" type="xml"><form><header><button name="action_prepare" type="object" string="Prepare" class="btn-primary" invisible="state != 'draft'"/><button name="action_review" type="object" string="Mark Reviewed" invisible="state != 'prepared'"/><field name="state" widget="statusbar" statusbar_visible="draft,prepared,reviewed"/></header><sheet><group><group><field name="company_id"/><field name="unit_id"/><field name="period_id"/><field name="return_id"/></group><group><field name="difference_amount" readonly="1"/><field name="note"/></group></group><field name="line_ids" readonly="state == 'reviewed'"><list editable="bottom"><field name="tax_head"/><field name="account_id"/><field name="ledger_amount"/><field name="return_amount"/><field name="difference" readonly="1"/><field name="explanation"/></list></field></sheet></form></field>
  </record>
  <record id="action_vat_reconciliation" model="ir.actions.act_window"><field name="name">VAT Reconciliation</field><field name="res_model">vat.reconciliation</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_input_apportionment_list" model="ir.ui.view"><field name="name">vat.input.apportionment.list</field><field name="model">vat.input.apportionment</field><field name="arch" type="xml"><list><field name="name"/><field name="period_id"/><field name="unit_id"/><field name="method"/><field name="eligible_percent"/><field name="eligible_input"/><field name="non_creditable_input"/><field name="state"/></list></field></record>
  <record id="view_vat_input_apportionment_form" model="ir.ui.view"><field name="name">vat.input.apportionment.form</field><field name="model">vat.input.apportionment</field><field name="arch" type="xml"><form><header><button name="action_calculate" type="object" string="Calculate" class="btn-primary" invisible="state != 'draft'"/><button name="action_approve" type="object" string="Approve" groups="zsl_vat.group_vat_manager" invisible="state != 'calculated'"/><field name="state" widget="statusbar" statusbar_visible="draft,calculated,approved"/></header><sheet><group><group><field name="company_id"/><field name="unit_id"/><field name="period_id"/><field name="method"/><field name="legal_reference"/></group><group><field name="taxable_turnover" invisible="method != 'turnover'"/><field name="exempt_turnover" invisible="method != 'turnover'"/><field name="approved_percent" invisible="method != 'custom'"/><field name="eligible_percent" readonly="1"/><field name="total_common_input" readonly="1"/><field name="eligible_input" readonly="1"/><field name="non_creditable_input" readonly="1"/></group></group></sheet></form></field></record>
  <record id="action_vat_input_apportionment" model="ir.actions.act_window"><field name="name">Input Tax Apportionment</field><field name="res_model">vat.input.apportionment</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_production_valuation_list" model="ir.ui.view"><field name="name">vat.production.valuation.list</field><field name="model">vat.production.valuation</field><field name="arch" type="xml"><list><field name="name"/><field name="production_id"/><field name="unit_id"/><field name="material_value"/><field name="finished_value"/><field name="wastage_value"/><field name="state"/></list></field></record>
  <record id="view_vat_production_valuation_form" model="ir.ui.view"><field name="name">vat.production.valuation.form</field><field name="model">vat.production.valuation</field><field name="arch" type="xml"><form><header><button name="action_validate" type="object" string="Validate" class="btn-primary" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="production_id"/><field name="unit_id"/><field name="material_value" readonly="1"/><field name="finished_value" readonly="1"/></group><group><field name="wastage_quantity" readonly="1"/><field name="wastage_value" readonly="1"/><field name="byproduct_value"/><field name="variance_value" readonly="1"/></group></group><field name="reason" placeholder="Explain damage, normal loss, destruction or other variance..."/></sheet></form></field></record>
  <record id="action_vat_production_valuation" model="ir.actions.act_window"><field name="name">Production Valuation &amp; Wastage</field><field name="res_model">vat.production.valuation</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_service_plan_list" model="ir.ui.view"><field name="name">vat.service.plan.list</field><field name="model">vat.service.plan</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="product_id"/><field name="recurrence"/><field name="next_invoice_date"/><field name="state"/></list></field></record>
  <record id="view_vat_service_plan_form" model="ir.ui.view"><field name="name">vat.service.plan.form</field><field name="model">vat.service.plan</field><field name="arch" type="xml"><form><header><button name="action_activate" type="object" string="Activate" class="btn-primary" invisible="state != 'draft'"/><button name="action_create_invoice" type="object" string="Create Invoice" class="btn-primary" invisible="state != 'active'"/><field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/></header><sheet><group><group><field name="name"/><field name="company_id"/><field name="unit_id"/><field name="partner_id"/><field name="product_id"/></group><group><field name="quantity"/><field name="price_unit"/><field name="recurrence"/><field name="start_date"/><field name="end_date"/><field name="next_invoice_date"/></group></group><notebook><page string="Generated Invoices"><field name="invoice_ids" readonly="1"><list><field name="name"/><field name="invoice_date"/><field name="amount_total"/><field name="state"/></list></field></page></notebook></sheet></form></field></record>
  <record id="action_vat_service_plan" model="ir.actions.act_window"><field name="name">Recurring Service Billing</field><field name="res_model">vat.service.plan</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_timesheet_billing_list" model="ir.ui.view"><field name="name">vat.timesheet.billing.list</field><field name="model">vat.timesheet.billing</field><field name="arch" type="xml"><list><field name="name"/><field name="partner_id"/><field name="work_date_from"/><field name="work_date_to"/><field name="total_hours"/><field name="amount"/><field name="invoice_id"/><field name="state"/></list></field></record>
  <record id="view_vat_timesheet_billing_form" model="ir.ui.view"><field name="name">vat.timesheet.billing.form</field><field name="model">vat.timesheet.billing</field><field name="arch" type="xml"><form><header><button name="action_create_invoice" type="object" string="Create Progress Invoice" class="btn-primary" invisible="state != 'draft'"/><field name="state" widget="statusbar"/></header><sheet><group><group><field name="company_id"/><field name="unit_id"/><field name="partner_id"/><field name="product_id"/><field name="price_per_hour"/></group><group><field name="work_date_from"/><field name="work_date_to"/><field name="total_hours" readonly="1"/><field name="amount" readonly="1"/><field name="invoice_id" readonly="1"/></group></group><field name="timesheet_ids" widget="many2many"><list><field name="date"/><field name="employee_id"/><field name="project_id"/><field name="task_id"/><field name="unit_amount"/><field name="name"/></list></field></sheet></form></field></record>
  <record id="action_vat_timesheet_billing" model="ir.actions.act_window"><field name="name">Timesheet / Project Billing</field><field name="res_model">vat.timesheet.billing</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_nbr_connector_list" model="ir.ui.view"><field name="name">vat.nbr.connector.list</field><field name="model">vat.nbr.connector</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="transport"/><field name="endpoint_url"/><field name="enabled"/><field name="last_tested_on"/></list></field></record>
  <record id="view_vat_nbr_connector_form" model="ir.ui.view"><field name="name">vat.nbr.connector.form</field><field name="model">vat.nbr.connector</field><field name="arch" type="xml"><form><header><button name="action_test_connection" type="object" string="Test Connection" class="btn-primary" invisible="transport != 'http_json'"/></header><sheet><group><field name="name"/><field name="company_id"/><field name="transport"/><field name="enabled"/><field name="endpoint_url" invisible="transport != 'http_json'"/><field name="api_token" password="True" invisible="transport != 'http_json'"/><field name="last_tested_on" readonly="1"/><field name="last_test_result" readonly="1"/></group><div class="text-muted" invisible="transport != 'manual'">Manual mode preserves the approved payload and CSV for upload to the official NBR portal. HTTP mode requires NBR-issued endpoint and credentials.</div></sheet></form></field></record>
  <record id="action_vat_nbr_connector" model="ir.actions.act_window"><field name="name">NBR API Connector</field><field name="res_model">vat.nbr.connector</field><field name="view_mode">list,form</field></record>

  <record id="view_vat_compliance_checklist_list" model="ir.ui.view"><field name="name">vat.compliance.checklist.list</field><field name="model">vat.compliance.checklist</field><field name="arch" type="xml"><list><field name="name"/><field name="company_id"/><field name="review_date"/><field name="scope"/><field name="state"/></list></field></record>
  <record id="view_vat_compliance_checklist_form" model="ir.ui.view"><field name="name">vat.compliance.checklist.form</field><field name="model">vat.compliance.checklist</field><field name="arch" type="xml"><form><header><button name="action_evaluate" type="object" string="Evaluate Controls" class="btn-primary"/><field name="state" widget="statusbar"/></header><sheet><group><field name="company_id"/><field name="review_date"/><field name="scope"/></group><field name="line_ids"><list editable="bottom"><field name="requirement_code"/><field name="requirement"/><field name="status"/><field name="evidence_note"/><field name="owner_id"/><field name="due_date"/></list></field><field name="attachment_ids" widget="many2many_binary"/><field name="conclusion" readonly="1"/></sheet></form></field></record>
  <record id="action_vat_compliance_checklist" model="ir.actions.act_window"><field name="name">NBR Compliance Checklist</field><field name="res_model">vat.compliance.checklist</field><field name="view_mode">list,form</field></record>

  <!-- Surface the cross-application VAT fields on the standard Odoo documents. -->
  <record id="view_pos_order_vat_form" model="ir.ui.view">
    <field name="name">pos.order.vat.form</field><field name="model">pos.order</field><field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
    <field name="arch" type="xml"><xpath expr="//group[@name='order_fields']" position="inside"><field name="vat_unit_id" readonly="1"/><field name="vat_mushak_number" readonly="1"/><field name="vat_invoice_id" readonly="1"/></xpath></field>
  </record>
  <record id="view_pos_config_vat_form" model="ir.ui.view">
    <field name="name">pos.config.vat.form</field><field name="model">pos.config</field><field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
    <field name="arch" type="xml"><xpath expr="//sheet" position="inside"><group string="Bangladesh VAT"><field name="vat_unit_id"/></group></xpath></field>
  </record>
  <record id="view_move_vat_service_form" model="ir.ui.view">
    <field name="name">account.move.vat.service.form</field><field name="model">account.move</field><field name="inherit_id" ref="account.view_move_form"/>
    <field name="arch" type="xml"><xpath expr="//sheet/notebook" position="inside"><page string="VAT Service"><group><field name="vat_supply_stage"/><field name="vat_time_of_supply_date"/><field name="vat_service_plan_id" readonly="1"/><field name="vat_timesheet_billing_id" readonly="1"/><field name="vat_service_evidence_ids" widget="many2many_binary"/></group></page></xpath></field>
  </record>
</odoo>
