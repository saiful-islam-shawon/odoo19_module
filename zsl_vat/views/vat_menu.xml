<?xml version='1.0' encoding='utf-8'?>
<odoo>
  <record id="action_vat_dashboard" model="ir.actions.client">
    <field name="name">VAT Dashboard</field>
    <field name="tag">zsl_vat.dashboard</field>
  </record>
  <record id="action_vat_ledger_books" model="ir.actions.act_window">
    <field name="name">VAT Ledger Books</field>
    <field name="res_model">account.account</field>
    <field name="view_mode">list,form</field>
  </record>
  <record id="action_vat_transactions" model="ir.actions.act_window">
    <field name="name">All VAT Transactions</field>
    <field name="res_model">account.move.line</field>
    <field name="view_mode">list,form</field>
    <field name="domain">[('parent_state', '=', 'posted')]</field>
  </record>
  <record id="action_vat_products" model="ir.actions.act_window">
    <field name="name">Product List</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">kanban,list,form</field>
  </record>
  <record id="action_vat_services" model="ir.actions.act_window">
    <field name="name">Service List</field>
    <field name="res_model">product.template</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('type', '=', 'service')]</field>
  </record>
  <record id="action_vat_customers" model="ir.actions.act_window">
    <field name="name">Customer List</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('customer_rank', '&gt;', 0)]</field>
  </record>
  <record id="action_vat_suppliers" model="ir.actions.act_window">
    <field name="name">Vendor List</field>
    <field name="res_model">res.partner</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="domain">[('supplier_rank', '&gt;', 0)]</field>
  </record>
  <record id="action_vat_print_purchase_book" model="ir.actions.act_window">
    <field name="name">Mushak 6.1 Purchase Book</field><field name="res_model">vat.book.wizard</field><field name="view_mode">form</field><field name="target">new</field><field name="context">{'default_book_type': 'purchase'}</field>
  </record>
  <record id="action_vat_print_sales_book" model="ir.actions.act_window">
    <field name="name">Mushak 6.2 Sales Book</field><field name="res_model">vat.book.wizard</field><field name="view_mode">form</field><field name="target">new</field><field name="context">{'default_book_type': 'sales'}</field>
  </record>
  <record id="action_vat_print_high_value_book" model="ir.actions.act_window">
    <field name="name">Mushak 6.10 High-value Transactions</field><field name="res_model">vat.book.wizard</field><field name="view_mode">form</field><field name="target">new</field><field name="context">{'default_book_type': 'high_value'}</field>
  </record>
  <record id="action_vat_print_out_invoice" model="ir.actions.act_window">
    <field name="name">Mushak 6.3 Tax Invoices</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('move_type', '=', 'out_invoice'), ('state', '=', 'posted')]</field>
  </record>
  <record id="action_vat_print_credit_note" model="ir.actions.act_window">
    <field name="name">Mushak 6.7 Credit Notes</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('move_type', '=', 'out_refund'), ('state', '=', 'posted')]</field>
  </record>
  <record id="action_vat_print_debit_note" model="ir.actions.act_window">
    <field name="name">Mushak 6.8 Debit Notes / Purchase Returns</field><field name="res_model">account.move</field><field name="view_mode">list,form</field><field name="domain">[('move_type', '=', 'in_refund'), ('state', '=', 'posted')]</field>
  </record>
  <record id="action_vat_print_contract_challan" model="ir.actions.act_window">
    <field name="name">Mushak 6.4 Contract Manufacturing Challans</field><field name="res_model">stock.picking</field><field name="view_mode">list,form</field><field name="domain">[('vat_challan_type', 'in', ('contract_send', 'contract_receive')), ('state', '=', 'done')]</field>
  </record>
  <record id="action_vat_print_turnover_return" model="ir.actions.act_window">
    <field name="name">Mushak 9.2 Turnover Tax Returns</field><field name="res_model">vat.return</field><field name="view_mode">list,form</field><field name="domain">[('return_type', 'in', ('main', 'late', 'amended', 'additional'))]</field><field name="context">{'default_return_type': 'main'}</field>
  </record>
