<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_zencore_hs_code_vat_form" model="ir.ui.view">
    <field name="name">zencore.hs.code.vat.form</field>
    <field name="model">zencore.hs.code</field>
    <field name="inherit_id" ref="zencore_hs_code.view_zencore_hs_code_form"/>
    <field name="arch" type="xml">
      <xpath expr="//sheet" position="inside">
        <notebook>
          <page name="zsl_vat_classification" string="Bangladesh VAT">
            <group>
              <group>
                <field name="code_type"/>
                <field name="vat_uom_id"/>
              </group>
              <group>
                <field name="treatment"/>
                <field name="vds_rate"/>
              </group>
            </group>
          </page>
          <page name="zsl_vat_tax_rules" string="VAT Tax Rules">
            <field name="tax_rule_ids" context="{'default_zencore_hs_code_id': id}">
              <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="tax_head"/>
                <field name="calculation"/>
                <field name="rate"/>
                <field name="account_tax_id"/>
                <field name="purchase_applicable"/>
                <field name="sale_applicable"/>
                <field name="creditable"/>
                <field name="active"/>
              </list>
            </field>
          </page>
        </notebook>
      </xpath>
    </field>
  </record>
</odoo>
