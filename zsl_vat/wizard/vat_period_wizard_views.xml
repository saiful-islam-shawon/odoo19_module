<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_vat_period_generate_wizard" model="ir.ui.view">
    <field name="name">vat.period.generate.wizard.form</field>
    <field name="model">vat.period.generate.wizard</field>
    <field name="arch" type="xml">
      <form string="Generate VAT Fiscal Periods">
        <group>
          <field name="company_id"/>
          <field name="unit_id"/>
          <field name="year"/>
          <field name="due_day"/>
        </group>
        <footer>
          <button name="action_generate" type="object" string="Generate 12 Monthly Periods" class="btn-primary"/>
          <button string="Cancel" special="cancel" class="btn-secondary"/>
        </footer>
      </form>
    </field>
  </record>
  <record id="action_vat_period_generate" model="ir.actions.act_window">
    <field name="name">Generate VAT Fiscal Periods</field>
    <field name="res_model">vat.period.generate.wizard</field>
    <field name="view_mode">form</field>
    <field name="target">new</field>
  </record>
</odoo>
